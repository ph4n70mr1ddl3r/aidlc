PORT=3000
DB_PATH=./data/itmanager.db
# MUST be changed to a random string >= 32 characters in production
SESSION_SECRET=generate-a-random-string-here
CSRF_SECRET=generate-another-random-string-here
NODE_ENV=development
TRUST_PROXY=0
# Set to auto-prune audit_log entries older than N days on startup (e.g. 365)
# Leave unset or 0 to disable pruning.
PRUNE_AUDIT_DAYS=0
# Production session store package (e.g. 'connect-sqlite3', 'connect-redis').
# The package must be installed (npm install connect-sqlite3) and a SESSION_STORE=connect-sqlite3
# configured. MemoryStore (the default) is NOT suitable for production.
# SESSION_STORE=connect-sqlite3
# MemoryStore (default, NOT suitable for production) — used when SESSION_STORE is unset.
# Default page size for paginated list views (default: 25, max: 100)
# PAGE_SIZE=25
# Seed passwords (only used by npm run seed; change defaults in shared/CI environments)
# If unset, the seeder generates a strong random password per role and prints
# it to the console. Set these to use fixed passwords in a shared dev/CI env.
# SEED_ADMIN_PASSWORD=<strong-admin-password>
# SEED_PASSWORD=<strong-staff-password>
