<%
  // Expected locals: page (numeric), totalPages, baseUrl (path with query params minus page)
  const _page = typeof page !== 'undefined' && typeof page === 'number' ? page : (typeof currentPage !== 'undefined' && typeof currentPage === 'number' ? currentPage : 1);
  const buildUrl = (p) => {
    const sep = baseUrl.includes('?') ? '&' : '?';
    return baseUrl + sep + 'page=' + p;
  };
%>
<% if (totalPages > 1) { %>
  <div class="pagination-info" aria-live="polite">
    Page <%= _page %> of <%= totalPages %>
  </div>
  <nav aria-label="Pagination">
  <div class="pagination">
    <% if (_page > 1) { %>
      <a href="<%= buildUrl(_page - 1) %>" aria-label="Previous page"><i class="fas fa-chevron-left"></i></a>
    <% } else { %>
      <span class="disabled" aria-hidden="true"><i class="fas fa-chevron-left"></i></span>
    <% } %>

    <% const start = Math.max(1, _page - 2); %>
    <% const end = Math.min(totalPages, _page + 2); %>
    <% if (start > 1) { %>
      <a href="<%= buildUrl(1) %>" aria-label="Page 1">1</a>
      <% if (start > 2) { %><span aria-hidden="true">…</span><% } %>
    <% } %>
    <% for (let p = start; p <= end; p++) { %>
      <% if (p === _page) { %>
        <span class="active" aria-current="page"><%= p %></span>
      <% } else { %>
        <a href="<%= buildUrl(p) %>" aria-label="Page <%= p %>"><%= p %></a>
      <% } %>
    <% } %>
    <% if (end < totalPages) { %>
      <% if (end < totalPages - 1) { %><span aria-hidden="true">…</span><% } %>
      <a href="<%= buildUrl(totalPages) %>" aria-label="Page <%= totalPages %>"><%= totalPages %></a>
    <% } %>

    <% if (_page < totalPages) { %>
      <a href="<%= buildUrl(_page + 1) %>" aria-label="Next page"><i class="fas fa-chevron-right"></i></a>
    <% } else { %>
      <span class="disabled" aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
    <% } %>
  </div>
  </nav>
<% } %>
