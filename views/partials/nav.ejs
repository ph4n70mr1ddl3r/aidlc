  <% if (user) { %>
  <nav class="sidebar" id="sidebar" aria-label="Main navigation">
    <div class="sidebar-brand">
      <i class="fas fa-server" aria-hidden="true"></i>
      <div><h2>IT Dept Manager</h2><small>Enterprise Edition</small></div>
    </div>
    <div class="sidebar-nav">
      <div class="nav-section">Main</div>
      <a href="/dashboard" class="nav-item <%= currentPage.startsWith('/dashboard') ? 'active' : '' %>"><i class="fas fa-chart-pie" aria-hidden="true"></i> Dashboard</a>
      <div class="nav-section">Operations</div>
      <a href="/tickets" class="nav-item <%= currentPage.startsWith('/ticket') ? 'active' : '' %>"><i class="fas fa-ticket" aria-hidden="true"></i> Tickets</a>
      <a href="/assets" class="nav-item <%= currentPage.startsWith('/asset') ? 'active' : '' %>"><i class="fas fa-box" aria-hidden="true"></i> Assets</a>
      <a href="/licenses" class="nav-item <%= currentPage.startsWith('/license') ? 'active' : '' %>"><i class="fas fa-key" aria-hidden="true"></i> Licenses</a>
      <a href="/projects" class="nav-item <%= currentPage.startsWith('/project') ? 'active' : '' %>"><i class="fas fa-project-diagram" aria-hidden="true"></i> Projects</a>
      <div class="nav-section">Management</div>
      <a href="/staff" class="nav-item <%= currentPage.startsWith('/staff') ? 'active' : '' %>"><i class="fas fa-users" aria-hidden="true"></i> Staff</a>
      <a href="/vendors" class="nav-item <%= currentPage.startsWith('/vendor') ? 'active' : '' %>"><i class="fas fa-building" aria-hidden="true"></i> Vendors</a>
      <a href="/changes" class="nav-item <%= currentPage.startsWith('/change') ? 'active' : '' %>"><i class="fas fa-history" aria-hidden="true"></i> Changes</a>
      <div class="nav-section">Resources</div>
      <a href="/knowledge" class="nav-item <%= currentPage.startsWith('/knowledge') ? 'active' : '' %>"><i class="fas fa-book" aria-hidden="true"></i> Knowledge Base</a>
      <% if (user.role === 'admin' || user.role === 'manager') { %>
      <a href="/reports" class="nav-item <%= currentPage.startsWith('/report') ? 'active' : '' %>"><i class="fas fa-chart-bar" aria-hidden="true"></i> Reports</a>
      <% } %>
    </div>
  </nav>
  <div class="main-content">
    <header class="header">
      <div class="header-left"><h1><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h1></div>
      <div class="header-right">
        <button class="btn btn-sm btn-outline mobile-menu-toggle" data-toggle="sidebar" title="Menu" aria-label="Toggle menu"><i class="fas fa-bars"></i></button>
        <a href="/tickets?status=open&assigned_to=<%= user.id %>" class="btn btn-sm btn-outline" title="My Tickets" aria-label="My Tickets"><i class="fas fa-bell"></i></a>
        <a href="/profile" class="user-menu">
          <div class="user-avatar"><%= (user.first_name || '?').charAt(0) %><%= (user.last_name || '?').charAt(0) %></div>
          <div class="user-info"><div class="name"><%= user.first_name %> <%= user.last_name %></div><div class="role"><%= user.role %></div></div>
        </a>
        <form action="/logout" method="POST" style="display:inline;"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-sm btn-outline" title="Logout" aria-label="Logout"><i class="fas fa-sign-out-alt"></i></button></form>
      </div>
    </header>
    <main class="page-content">
      <% if (flash.success && flash.success.length) { flash.success.forEach(m => { %>
        <div class="flash success" role="alert"><i class="fas fa-check-circle"></i> <%= m %></div>
      <% }) } %>
      <% if (flash.error && flash.error.length) { flash.error.forEach(m => { %>
        <div class="flash error" role="alert"><i class="fas fa-exclamation-circle"></i> <%= m %></div>
      <% }) } %>
      <% if (flash.info && flash.info.length) { flash.info.forEach(m => { %>
        <div class="flash info" role="status"><i class="fas fa-info-circle"></i> <%= m %></div>
      <% }) } %>
  <% } %>
