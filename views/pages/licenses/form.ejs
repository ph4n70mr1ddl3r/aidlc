<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header"><div><h2><%= isEdit ? 'Edit License' : 'New License' %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/licenses">Licenses</a> / <%= isEdit ? 'Edit' : 'New' %></div></div></div>
<div class="card"><div class="card-body">
  <form action="<%= isEdit ? '/licenses/' + license.id + '?_method=PUT' : '/licenses' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="form-group"><label for="software_name">Software Name *</label><input type="text" name="software_name" id="software_name" class="form-control" value="<%= license.software_name || '' %>" maxlength="<%= CONSTANTS.MAX_MEDIUM_STR %>" required></div>
      <div class="form-group"><label for="vendor">Vendor</label><input type="text" name="vendor" id="vendor" class="form-control" value="<%= license.vendor || '' %>" maxlength="<%= CONSTANTS.MAX_MEDIUM_STR %>"></div>
      <div class="form-group"><label for="license_key">License Key</label><input type="text" name="license_key" id="license_key" class="form-control" placeholder="Enter new key or leave blank to keep current" maxlength="<%= CONSTANTS.MAX_LONG_STR %>" style="font-family:monospace;" autocomplete="off"></div>
      <% if (isEdit && license.license_key) { %><div class="form-group"><label><input type="checkbox" name="clear_key" id="clear_key" value="on"> Clear existing key</label></div><% } %>
      <div class="form-group"><label for="license_type">License Type</label><select name="license_type" id="license_type" class="form-control">
        <% CONSTANTS.LICENSE_TYPES.forEach(t => { %><option value="<%= t %>" <%= license.license_type === t ? 'selected' : '' %>><%= titleCase(t) %></option><% }) %>
      </select></div>
      <div class="form-group"><label for="total_seats">Total Seats</label><input type="number" name="total_seats" id="total_seats" class="form-control" value="<%= license.total_seats != null ? license.total_seats : 1 %>" min="1" max="1000000" required></div>
      <div class="form-group"><label for="used_seats">Used Seats</label><input type="number" name="used_seats" id="used_seats" class="form-control" value="<%= license.used_seats != null ? license.used_seats : 0 %>" min="0" max="1000000" required></div>
      <div class="form-group"><label for="purchase_date">Purchase Date</label><input type="date" name="purchase_date" id="purchase_date" class="form-control" value="<%= license.purchase_date ? license.purchase_date.slice(0,10) : '' %>"></div>
      <div class="form-group"><label for="expiry_date">Expiry Date</label><input type="date" name="expiry_date" id="expiry_date" class="form-control" value="<%= license.expiry_date ? license.expiry_date.slice(0,10) : '' %>"></div>
      <div class="form-group"><label for="cost">Cost ($)</label><input type="number" name="cost" id="cost" class="form-control" step="0.01" min="0" max="99999999.99" value="<%= license.cost != null ? license.cost : '' %>"></div>
    </div>
    <div class="form-group"><label for="notes">Notes</label><textarea name="notes" id="notes" class="form-control" maxlength="<%= CONSTANTS.MAX_NOTES %>"><%= license.notes || '' %></textarea></div>
    <div style="margin-top:20px;display:flex;gap:12px;">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= isEdit ? 'Update' : 'Create' %></button>
      <a href="/licenses" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div></div>
<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
