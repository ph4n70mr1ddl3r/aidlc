<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header"><div><h2><%= isEdit ? 'Edit License' : 'New License' %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/licenses">Licenses</a> / <%= isEdit ? 'Edit' : 'New' %></div></div></div>
<div class="card"><div class="card-body">
  <form action="<%= isEdit ? '/licenses/' + license.id + '?_method=PUT' : '/licenses' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="form-group"><label>Software Name *</label><input type="text" name="software_name" class="form-control" value="<%= license.software_name || '' %>" maxlength="200" required></div>
      <div class="form-group"><label>Vendor</label><input type="text" name="vendor" class="form-control" value="<%= license.vendor || '' %>" maxlength="200"></div>
      <div class="form-group"><label>License Key</label><input type="text" name="license_key" class="form-control" value="<%= license.license_key || '' %>" maxlength="500" style="font-family:monospace;"></div>
      <div class="form-group"><label>License Type</label><select name="license_type" class="form-control">
        <% ['perpetual','subscription','volume','oem','academic'].forEach(t => { %><option value="<%= t %>" <%= license.license_type === t ? 'selected' : '' %>><%= t.charAt(0).toUpperCase() + t.slice(1) %></option><% }) %>
      </select></div>
      <div class="form-group"><label>Total Seats</label><input type="number" name="total_seats" class="form-control" value="<%= license.total_seats || 1 %>" min="1"></div>
      <div class="form-group"><label>Used Seats</label><input type="number" name="used_seats" class="form-control" value="<%= license.used_seats || 0 %>" min="0"></div>
      <div class="form-group"><label>Purchase Date</label><input type="date" name="purchase_date" class="form-control" value="<%= license.purchase_date ? license.purchase_date.slice(0,10) : '' %>"></div>
      <div class="form-group"><label>Expiry Date</label><input type="date" name="expiry_date" class="form-control" value="<%= license.expiry_date ? license.expiry_date.slice(0,10) : '' %>"></div>
      <div class="form-group"><label>Cost ($)</label><input type="number" name="cost" class="form-control" step="0.01" value="<%= license.cost || '' %>"></div>
    </div>
    <div class="form-group"><label>Notes</label><textarea name="notes" class="form-control"><%= license.notes || '' %></textarea></div>
    <div style="margin-top:20px;display:flex;gap:12px;">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= isEdit ? 'Update' : 'Create' %></button>
      <a href="/licenses" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div></div>
<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
