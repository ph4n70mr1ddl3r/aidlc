<%- include('../partials/header') %>
<%- include('../partials/nav') %>

<% // The "(N+)" markers on the capped cards below are driven by the EXACT
   // `*Truncated` flags the route computes (the queries fetch one row beyond
   // the cap as a probe, so a list holding exactly as many rows as the cap is
   // complete and is NOT marked). The old `length >= cap` heuristic claimed a
   // truncation that did not exist. The warranty/license alert lists further
   // down use the equivalent uncapped count already in the render context. %>

<!-- Stats Cards -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon blue"><i class="fas fa-ticket" aria-hidden="true"></i></div>
    <div>
      <!-- "Active" matches the app-wide definition used by My Active Tickets,
           Team Workload, and Active Tickets by Category: open + in_progress +
           waiting (every non-terminal status). -->
      <div class="stat-value"><%= ticketStats.open + ticketStats.in_progress + (ticketStats.waiting || 0) %></div>
      <div class="stat-label">Active Tickets</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon <%= ticketStats.critical_open > 0 ? 'red' : 'green' %>"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i></div>
    <div>
      <div class="stat-value"><%= ticketStats.critical_open %></div>
      <div class="stat-label">Critical Open</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon green"><i class="fas fa-box" aria-hidden="true"></i></div>
    <div>
      <div class="stat-value"><%= assetStats.total %></div>
      <div class="stat-label">Active Assets</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon purple"><i class="fas fa-project-diagram" aria-hidden="true"></i></div>
    <div>
      <% // planning + in_progress + on_hold — the app-wide definition of an
         // active project (see staff.js ownership-clearing and the projects
         // module). Counting only in_progress contradicted every other active
         // metric on this page and left planning/on_hold unused. %>
      <div class="stat-value"><%= projectStats.planning + projectStats.in_progress + projectStats.on_hold %></div>
      <div class="stat-label">Active Projects</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon cyan"><i class="fas fa-users" aria-hidden="true"></i></div>
    <div>
      <div class="stat-value"><%= staffCount.total %></div>
      <div class="stat-label">IT Staff</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon orange"><i class="fas fa-wrench" aria-hidden="true"></i></div>
    <div>
      <div class="stat-value"><%= assetStats.in_repair %></div>
      <div class="stat-label">In Repair</div>
    </div>
  </div>
</div>

<!-- Alerts -->
<% if (ticketStats.critical_open > 0) { %>
  <div class="alert-card danger">
    <h4><i class="fas fa-exclamation-triangle" aria-hidden="true"></i> Critical Tickets Alert</h4>
    <p><%= ticketStats.critical_open %> critical ticket(s) require immediate attention</p>
  </div>
<% } %>

<% if (expiringWarrantiesCount > 0) { %>
  <div class="alert-card">
    <% // The count includes ALREADY-EXPIRED warranties (the query uses
       // `warranty_expiry <= date('now', '+30 days')`), so the heading must
       // not say "Expiring Soon" — an expired warranty is the more urgent
       // case. Mirrors the list card's "Warranty Ending or Expired" heading
       // and the body copy below. %>
    <h4><i class="fas fa-shield-alt" aria-hidden="true"></i> Warranty Ending or Expired</h4>
    <p><%= expiringWarrantiesCount %> asset(s) with a warranty expired or expiring within 30 days</p>
  </div>
<% } %>

<% if (licenseAlertsCount > 0) { %>
  <div class="alert-card">
    <% // Same expired-inclusive semantics as the warranty alert above. %>
    <h4><i class="fas fa-key" aria-hidden="true"></i> Licenses Ending or Expired</h4>
    <p><%= licenseAlertsCount %> software license(s) expired or expiring within 30 days</p>
  </div>
<% } %>

<div class="grid-2-1">
  <!-- My Tickets -->
  <div class="card">
    <div class="card-header">
      <h3><i class="fas fa-user-clock" aria-hidden="true" style="margin-right:8px;color:var(--primary)"></i>My Active Tickets (<%= myTickets.length %><%= (typeof myTicketsTruncated !== 'undefined' && myTicketsTruncated) ? '+' : '' %>)</h3>
      <a href="/tickets?assigned_to=<%= user.id %>" class="btn btn-sm btn-outline">View All</a>
    </div>
    <div class="card-body" style="padding:0;">
      <% if (!Array.isArray(myTickets) || myTickets.length === 0) { %>
        <div class="empty-state" style="padding:30px;">
          <i class="fas fa-check-circle" aria-hidden="true" style="color:var(--success)"></i>
          <h3>All caught up!</h3>
          <p>No active tickets assigned to you</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table>
            <thead><tr><th>Ticket</th><th>Title</th><th>Priority</th><th>Status</th><th>Created</th></tr></thead>
            <tbody>
              <% myTickets.forEach(t => { %>
              <tr>
                <td><a href="/tickets/<%= t.id %>" style="color:var(--primary);text-decoration:none;font-weight:600;"><%= t.ticket_number %></a></td>
                <td><%= t.title %></td>
                <td><span class="badge badge-<%= badgeClass(t.priority || 'medium', TICKET_PRIORITY_BADGE) %>"><%= titleCase(t.priority || 'medium') %></span></td>
                <td><span class="badge badge-<%= badgeClass(t.status || 'open', TICKET_STATUS_BADGE) %>"><%= titleCase(t.status || 'open') %></span></td>
                <td class="text-sm"><%= formatDateTime(t.created_at) %></td>
              </tr>
        <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Quick Stats Sidebar -->
  <div>
    <!-- Staff Workload -->
    <div class="card mb-2">
      <div class="card-header"><h3><i class="fas fa-chart-bar" aria-hidden="true" style="margin-right:8px;color:var(--primary)"></i>Team Workload (<%= staffWorkload.length %><%= (typeof staffWorkloadTruncated !== 'undefined' && staffWorkloadTruncated) ? '+' : '' %>)</h3></div>
      <div class="card-body">
        <% if (Array.isArray(staffWorkload)) { staffWorkload.forEach(s => { %>
          <div style="margin-bottom:12px;">
            <div class="flex justify-between mb-1">
              <span class="text-sm"><%= s.name %></span>
              <span class="text-sm text-muted"><%= s.open_tickets %> tickets</span>
            </div>
            <div class="progress-bar" role="progressbar" aria-valuenow="<%= Math.min(s.open_tickets * CONSTANTS.WORKLOAD_MULTIPLIER, 100) %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= s.name %>: <%= s.open_tickets %> open tickets" >
              <div class="progress-fill <%= s.open_tickets > CONSTANTS.WORKLOAD_RED_THRESHOLD ? 'red' : s.open_tickets > CONSTANTS.WORKLOAD_ORANGE_THRESHOLD ? 'orange' : 'green' %>"
                   style="width: <%= Math.min(s.open_tickets * CONSTANTS.WORKLOAD_MULTIPLIER, 100) %>%"></div>
            </div>
          </div>
        <% }) } %>
        <% if (!Array.isArray(staffWorkload) || staffWorkload.length === 0) { %><p class="text-muted text-sm">No workload data</p><% } %>
      </div>
    </div>

    <!-- Upcoming Changes -->
    <% if (Array.isArray(upcomingChanges) && upcomingChanges.length > 0) { %>
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-calendar" aria-hidden="true" style="margin-right:8px;color:var(--warning)"></i>Upcoming Changes (<%= upcomingChanges.length %><%= (typeof upcomingChangesTruncated !== 'undefined' && upcomingChangesTruncated) ? '+' : '' %>)</h3></div>
      <div class="card-body">
        <% upcomingChanges.forEach(c => { %>
          <div style="margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--border);">
            <div class="text-sm" style="font-weight:600;"><%= c.title %></div>
            <div class="text-sm text-muted"><i class="fas fa-clock" aria-hidden="true"></i> <%= formatDateTime(c.scheduled_start) %></div>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<!-- Recently Active Tickets — non-terminal tickets ordered by last update,
     matching the "active" definition used by every other widget on this page. -->
<div class="card mt-3">
  <div class="card-header">
    <h3><i class="fas fa-clock" aria-hidden="true" style="margin-right:8px;color:var(--primary)"></i>Recently Active Tickets (<%= recentTickets.length %><%= (typeof recentTicketsTruncated !== 'undefined' && recentTicketsTruncated) ? '+' : '' %>)</h3>
    <a href="/tickets" class="btn btn-sm btn-outline">View All</a>
  </div>
  <div class="card-body" style="padding:0;">
    <% if (!Array.isArray(recentTickets) || recentTickets.length === 0) { %>
      <div class="empty-state" style="padding:30px;">
        <i class="fas fa-check-circle" aria-hidden="true" style="color:var(--success)"></i>
        <h3>No open tickets</h3>
        <p>No unresolved tickets in the system</p>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table>
        <thead><tr><th>Ticket</th><th>Title</th><th>Category</th><th>Priority</th><th>Status</th><th>Assigned To</th><th>Created</th></tr></thead>
        <tbody>
          <% recentTickets.forEach(t => {
            const canView = isPrivileged(user) || Number(t.assigned_to) === Number(user.id); %>
           <tr>
             <td><% if (canView) { %><a href="/tickets/<%= t.id %>" style="color:var(--primary);text-decoration:none;font-weight:600;"><%= t.ticket_number %></a><% } else { %><span style="font-weight:600;"><%= t.ticket_number %></span><% } %></td>
             <td><% if (canView) { %><a href="/tickets/<%= t.id %>" style="color:var(--text);text-decoration:none;"><%= t.title %></a><% } else { %><%= t.title %><% } %></td>
              <td class="text-sm"><%= titleCase(t.category || 'other') %></td>
              <td><span class="badge badge-<%= badgeClass(t.priority || 'medium', TICKET_PRIORITY_BADGE) %>"><%= titleCase(t.priority || 'medium') %></span></td>
              <td><span class="badge badge-<%= badgeClass(t.status || 'open', TICKET_STATUS_BADGE) %>"><%= titleCase(t.status || 'open') %></span></td>
             <td class="text-sm"><%= t.assigned_name || 'Unassigned' %></td>
             <td class="text-sm"><%= formatDateTime(t.created_at) %></td>
           </tr>
         <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<!-- Warranty and license alerts — the LISTS behind the two alert cards above.
     Until now the dashboard only reported HOW MANY assets/licenses were
     expiring: the alert card showed a count, and the rows the queries
     actually loaded were never rendered. The two list caps in
     DASHBOARD_LIMITS (warrantyAlerts / licenseAlerts) were therefore dead
     knobs — the constants file promised an "(N+)" truncation marker that no
     list could ever show. Rendering the lists makes both caps live and tells
     the reader WHICH assets/licenses need attention. The "(N+)" marker
     discloses the truncation exactly like every other capped list in the app.
     For these two lists the EXACT total is already in the render context
     (expiringWarrantiesCount / licenseAlertsCount), so the marker compares
     the rendered length against the count: a list that happens to hold
     exactly as many rows as the cap is complete, and the old ">=" heuristic
     would have claimed a truncation that does not exist. -->
<% if (Array.isArray(expiringWarranties) && expiringWarranties.length > 0) { %>
<div class="card mt-3">
  <div class="card-header">
    <h3><i class="fas fa-shield-alt" aria-hidden="true" style="margin-right:8px;color:var(--warning)"></i>Warranty Ending or Expired (<%= expiringWarranties.length %><%= expiringWarranties.length < expiringWarrantiesCount ? '+' : '' %>)</h3>
  </div>
  <div class="card-body" style="padding:0;">
    <div class="table-responsive">
      <table>
        <thead><tr><th>Asset</th><th>Name</th><th>Warranty Expiry</th><th>Days Left</th></tr></thead>
        <tbody>
        <% expiringWarranties.forEach(a => {
          const _wDays = daysUntil(a.warranty_expiry); %>
          <tr>
            <% // Link to the (open-to-all-staff) asset list filtered by the tag
               // rather than to the ownership-gated asset detail page — the
               // ticket show page uses the same pattern. %>
            <td><a href="/assets?search=<%= encodeURIComponent(a.asset_tag) %>" style="color:var(--primary);text-decoration:none;font-weight:600;"><%= a.asset_tag %></a></td>
            <td><%= a.name %></td>
            <td class="text-sm"><%= formatDate(a.warranty_expiry) %></td>
            <td class="text-sm"><% if (_wDays === null) { %>-<% } else { %><span class="badge badge-<%= badgeClass(_wDays < 0 ? 'expired' : 'expiring_soon', CONSTANTS.WARRANTY_DEADLINE_BADGE) %>"><%= _wDays < 0 ? 'Expired ' + Math.abs(_wDays) + ' days ago' : _wDays + ' days' %></span><% } %></td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } %>

<% // The license list is admin/manager-only: the licenses module is
   // requireAdminOrManager (cost/seat data is business-sensitive), so the
   // software names are only rendered for a privileged viewer. The alert card
   // above still shows the bare count to everyone — it carries no license
   // identity. %>
<% if (isPrivileged(user) && Array.isArray(licenseAlerts) && licenseAlerts.length > 0) { %>
<div class="card mt-3">
  <div class="card-header">
    <h3><i class="fas fa-key" aria-hidden="true" style="margin-right:8px;color:var(--warning)"></i>Licenses Ending or Expired (<%= licenseAlerts.length %><%= licenseAlerts.length < licenseAlertsCount ? '+' : '' %>)</h3>
  </div>
  <div class="card-body" style="padding:0;">
    <div class="table-responsive">
      <table>
        <thead><tr><th>Software</th><th>Vendor</th><th>Expiry</th><th>Days Left</th></tr></thead>
        <tbody>
        <% licenseAlerts.forEach(l => {
          const _lDays = daysUntil(l.expiry_date); %>
          <tr>
            <td><a href="/licenses/<%= l.id %>" style="color:var(--primary);text-decoration:none;font-weight:600;"><%= l.software_name %></a></td>
            <td class="text-sm"><%= l.vendor || '-' %></td>
            <td class="text-sm"><%= formatDate(l.expiry_date) %></td>
            <td class="text-sm"><% if (_lDays === null) { %>-<% } else { %><span class="badge badge-<%= badgeClass(_lDays < 0 ? 'expired' : 'expiring_soon', CONSTANTS.WARRANTY_DEADLINE_BADGE) %>"><%= _lDays < 0 ? 'Expired ' + Math.abs(_lDays) + ' days ago' : _lDays + ' days' %></span><% } %></td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } %>

<!-- Active Tickets by Category -->
<% if (Array.isArray(ticketsByCategory) && ticketsByCategory.length > 0) { %>
<div class="card mt-3">
  <div class="card-header"><h3><i class="fas fa-chart-pie" aria-hidden="true" style="margin-right:8px;color:var(--primary)"></i>Active Tickets by Category</h3></div>
  <div class="card-body">
    <div class="grid-3" style="gap:12px;">
      <% const catTotal = ticketsByCategory.reduce((a, b) => a + b.count, 0); %>
      <% ticketsByCategory.forEach(c => { const pct = catTotal > 0 ? Math.round(c.count / catTotal * 100) : 0; %>
      <div style="padding:12px;background:var(--bg);border-radius:8px;text-align:center;">
        <div style="font-size:24px;font-weight:700;color:var(--primary);"><%= c.count %></div>
        <div class="text-sm text-muted"><%= titleCase(c.category || 'other') %></div>
        <div class="text-sm text-muted"><%= pct %>%</div>
      </div>
      <% }) } %>
    </div>
  </div>
</div>

<%- include('../partials/nav-close') %>
<%- include('../partials/footer') %>
