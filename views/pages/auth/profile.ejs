<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div>
    <h2>My Profile</h2>
    <div class="breadcrumb"><a href="/dashboard">Dashboard</a> / Profile</div>
  </div>
</div>

<div class="grid-2">
  <!-- Profile Info -->
  <div class="card">
    <div class="card-header"><h3><i class="fas fa-user" style="margin-right:8px;color:var(--primary)"></i>Profile Information</h3></div>
    <div class="card-body">
      <form action="/profile?_method=PUT" method="POST">
        <div class="form-grid">
          <div class="form-group">
            <label>First Name</label>
            <input type="text" name="first_name" class="form-control" value="<%= profileUser.first_name %>" required>
          </div>
          <div class="form-group">
            <label>Last Name</label>
            <input type="text" name="last_name" class="form-control" value="<%= profileUser.last_name %>" required>
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-control" value="<%= profileUser.email %>" required>
          </div>
          <div class="form-group">
            <label>Phone</label>
            <input type="text" name="phone" class="form-control" value="<%= profileUser.phone || '' %>">
          </div>
        </div>
        <div class="form-group">
          <label>Username</label>
          <input type="text" class="form-control" value="<%= profileUser.username %>" disabled style="background:var(--bg)">
        </div>
        <div class="form-group">
          <label>Role</label>
          <input type="text" class="form-control" value="<%= profileUser.role %>" disabled style="background:var(--bg);text-transform:capitalize;">
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
      </form>
    </div>
  </div>

  <!-- Change Password -->
  <div class="card">
    <div class="card-header"><h3><i class="fas fa-lock" style="margin-right:8px;color:var(--warning)"></i>Change Password</h3></div>
    <div class="card-body">
      <form action="/profile/password?_method=PUT" method="POST">
        <div class="form-group">
          <label>Current Password</label>
          <input type="password" name="current_password" class="form-control" required>
        </div>
        <div class="form-group">
          <label>New Password</label>
          <input type="password" name="new_password" class="form-control" required minlength="6">
        </div>
        <div class="form-group">
          <label>Confirm New Password</label>
          <input type="password" name="confirm_password" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-key"></i> Change Password</button>
      </form>
    </div>
  </div>
</div>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
