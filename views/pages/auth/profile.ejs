<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div>
    <h2>My Profile</h2>
    <div class="breadcrumb"><a href="/dashboard">Dashboard</a> / Profile</div>
  </div>
</div>

<div class="grid-2">
  <!-- Profile Info -->
  <div class="card">
    <div class="card-header"><h3><i class="fas fa-user" style="margin-right:8px;color:var(--primary)"></i>Profile Information</h3></div>
    <div class="card-body">
      <form action="/profile?_method=PUT" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-grid">
          <div class="form-group">
            <label for="first_name">First Name</label>
            <input type="text" name="first_name" id="first_name" class="form-control" value="<%= profileUser.first_name %>" maxlength="<%= CONSTANTS.MAX_SHORT_STR %>" required>
          </div>
          <div class="form-group">
            <label for="last_name">Last Name</label>
            <input type="text" name="last_name" id="last_name" class="form-control" value="<%= profileUser.last_name %>" maxlength="<%= CONSTANTS.MAX_SHORT_STR %>" required>
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" name="email" id="email" class="form-control" value="<%= profileUser.email %>" maxlength="<%= CONSTANTS.MAX_EMAIL %>" required autocomplete="email">
          </div>
          <div class="form-group">
            <label for="phone">Phone</label>
            <input type="text" name="phone" id="phone" class="form-control" value="<%= profileUser.phone || '' %>" maxlength="<%= CONSTANTS.MAX_PHONE %>">
          </div>
        </div>
        <div class="form-group">
          <label>Username</label>
          <input type="text" class="form-control" value="<%= profileUser.username %>" disabled style="background:var(--bg)">
        </div>
        <div class="form-group">
          <label>Role</label>
          <input type="text" class="form-control" value="<%= titleCase(profileUser.role) %>" disabled style="background:var(--bg);">
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
      </form>
    </div>
  </div>

  <!-- Change Password -->
  <div class="card">
    <div class="card-header"><h3><i class="fas fa-lock" style="margin-right:8px;color:var(--warning)"></i>Change Password</h3></div>
    <div class="card-body">
      <form action="/profile/password?_method=PUT" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="current_password">Current Password</label>
          <input type="password" name="current_password" id="current_password" class="form-control" required maxlength="<%= CONSTANTS.MAX_PASSWORD %>" autocomplete="current-password">
        </div>
        <div class="form-group">
          <label for="new_password">New Password</label>
          <input type="password" name="new_password" id="new_password" class="form-control" required minlength="12" maxlength="<%= CONSTANTS.MAX_PASSWORD %>" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{12,}" title="Minimum 12 characters with uppercase, lowercase, number, and special character" autocomplete="new-password">
        </div>
        <div class="form-group">
          <label for="confirm_password">Confirm New Password</label>
          <input type="password" name="confirm_password" id="confirm_password" class="form-control" required maxlength="<%= CONSTANTS.MAX_PASSWORD %>" autocomplete="new-password">
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-key"></i> Change Password</button>
      </form>
    </div>
  </div>
</div>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
