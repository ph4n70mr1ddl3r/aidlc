<%- include('../../partials/header') %>

<div class="login-container">
  <div class="login-card">
    <div style="text-align:center;margin-bottom:24px;">
      <i class="fas fa-server" style="font-size:40px;color:var(--primary);"></i>
    </div>
    <h1 style="text-align:center;">IT Department Manager</h1>
    <p style="text-align:center;">Sign in to your account</p>
    
    <% if (flash.error && flash.error.length) { flash.error.forEach(m => { %>
      <div class="flash error" role="alert"><i class="fas fa-exclamation-circle"></i> <%= m %></div>
    <% }) } %>
    <% if (reason === 'deactivated') { %>
      <div class="flash error" role="alert"><i class="fas fa-exclamation-circle"></i> Your account has been deactivated. Contact your administrator.</div>
    <% } else if (reason === 'password_changed') { %>
      <div class="flash info" role="status"><i class="fas fa-info-circle"></i> Your session has expired because your password was changed. Please log in again.</div>
    <% } %>
    <% if (flash.success && flash.success.length) { flash.success.forEach(m => { %>
      <div class="flash success" role="alert"><i class="fas fa-check-circle"></i> <%= m %></div>
    <% }) } %>
    <% if (flash.info && flash.info.length) { flash.info.forEach(m => { %>
      <div class="flash info" role="status"><i class="fas fa-info-circle"></i> <%= m %></div>
    <% }) } %>

    <form action="/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" name="username" id="username" class="form-control" placeholder="Enter username" required autofocus autocomplete="username" maxlength="<%= CONSTANTS.MAX_USERNAME %>">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" name="password" id="password" class="form-control" placeholder="Enter password" required autocomplete="current-password" maxlength="<%= CONSTANTS.MAX_PASSWORD %>">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:8px;">
        <i class="fas fa-sign-in-alt"></i> Sign In
      </button>
    </form>
    <p style="text-align:center;margin-top:20px;font-size:12px;color:var(--text-light);">
      Contact your administrator for login credentials
    </p>
  </div>
</div>

<%- include('../../partials/footer') %>
