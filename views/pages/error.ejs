<%- include('../partials/header') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg);">
  <div style="text-align:center;max-width:500px;padding:20px;">
    <h1 style="font-size:72px;font-weight:800;color:var(--danger);line-height:1;"><%= typeof statusCode !== 'undefined' ? statusCode : 500 %></h1>
    <h2 style="margin-bottom:12px;"><%= typeof statusCode !== 'undefined' && statusCode < 500 ? 'Request Error' : 'Server Error' %></h2>
    <% if (typeof error !== 'undefined' && error && error.message) { %>
      <% // EJS escaped-output interpolation already HTML-escapes its
         // expression. The previous manual escapeHtml() call had two
         // defects: (1) it double-escaped every message containing &/</>
         // ("a < b" displayed as the literal text "a &lt; b"), and (2) it
         // referenced a res.locals helper that is genuinely UNDEFINED when
         // the error was thrown BEFORE the res.locals middleware ran (e.g.
         // body-parser 413/400) — the render then threw a secondary
         // ReferenceError and Express downgraded the styled page to a
         // bare-text 500 with a wrong status code. Relying on the built-in
         // escaping fixes both — the same class fixed for header.ejs's
         // csrfToken guard (pass 141) and the audit details column
         // (double-escape). %>
      <p style="margin-bottom:12px;padding:12px;background:var(--danger-light);border-radius:8px;font-family:monospace;font-size:13px;"><%= error.message %></p>
    <% } else { %>
      <p style="margin-bottom:12px;padding:12px;background:var(--danger-light);border-radius:8px;">An unexpected error occurred.</p>
    <% } %>
    <p class="text-muted" style="margin-bottom:24px;">Something went wrong. Please try again later.</p>
    <% // Auth-gated CTA mirroring 404.ejs: signed-in visitors get "Go to
       // Dashboard", anonymous ones get "Go to Login". `user` is guarded
       // because this handler can render for failures thrown BEFORE the
       // res.locals middleware ran (e.g. body-parser 413/400), leaving the
       // local genuinely undefined rather than null.
       %>
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/dashboard" class="btn btn-primary"><i class="fas fa-home" aria-hidden="true"></i> Go to Dashboard</a>
    <% } else { %>
      <a href="/login" class="btn btn-primary"><i class="fas fa-sign-in-alt" aria-hidden="true"></i> Go to Login</a>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
