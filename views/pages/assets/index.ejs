<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div>
    <h2>Assets <span class="text-sm text-muted" style="font-weight:normal;">(<%= total %> total)</span></h2>
    <div class="breadcrumb"><a href="/dashboard">Dashboard</a> / Assets</div>
  </div>
  <% if (user.role === 'admin' || user.role === 'manager') { %>
  <a href="/assets/new" class="btn btn-primary"><i class="fas fa-plus"></i> New Asset</a>
  <% } %>
</div>

<form method="GET" action="/assets" class="filter-bar">
  <input type="text" name="search" class="search-input" placeholder="Search assets..." value="<%= filters.search || '' %>">
  <select name="category">
    <option value="">All Categories</option>
    <% ['laptop','desktop','server','monitor','printer','network','phone','tablet','software','peripheral','other'].forEach(c => { %>
      <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c.charAt(0).toUpperCase() + c.slice(1) %></option>
    <% }) %>
  </select>
  <select name="status">
    <option value="">All Status</option>
    <% ['in_use','in_storage','in_repair','disposed','reserved'].forEach(s => { %>
      <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %></option>
    <% }) %>
  </select>
  <% if (typeof staff !== 'undefined') { %>
  <select name="assigned_to">
    <option value="">All Assignees</option>
    <% staff.forEach(s => { %>
      <option value="<%= s.id %>" <%= filters.assigned_to == String(s.id) ? 'selected' : '' %>><%= s.first_name %> <%= s.last_name %></option>
    <% }) %>
  </select>
  <% } %>
  <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i> Filter</button>
  <a href="/assets" class="btn btn-sm btn-outline">Clear</a>
</form>

<div class="card">
  <div class="card-body" style="padding:0;">
    <% if (assets.length === 0) { %>
      <div class="empty-state"><i class="fas fa-box"></i><h3>No assets found</h3><p>Add your first asset or adjust filters</p></div>
    <% } else { %>
    <div class="table-responsive">
      <table>
        <thead><tr><th>Asset Tag</th><th>Name</th><th>Category</th><th>Status</th><th>Condition</th><th>Assigned To</th><th>Location</th><th>Actions</th></tr></thead>
        <tbody>
          <% assets.forEach(a => { %>
          <tr>
            <td><a href="/assets/<%= a.id %>" style="color:var(--primary);font-weight:600;text-decoration:none;"><%= a.asset_tag %></a></td>
            <td><%= a.manufacturer %> <%= a.name %></td>
            <td class="text-sm"><%= a.category %></td>
            <td><span class="badge badge-<%= a.status %>"><%= a.status.replace(/_/g, ' ') %></span></td>
            <td><span class="badge badge-<%= a.condition_rating === 'new' ? 'low' : a.condition_rating === 'good' ? 'low' : a.condition_rating === 'fair' ? 'medium' : 'critical' %>"><%= a.condition_rating %></span></td>
            <td class="text-sm"><%= a.assigned_name || '-' %></td>
            <td class="text-sm"><%= a.location || '-' %></td>
            <td class="actions-cell">
              <a href="/assets/<%= a.id %>" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i></a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<% if (typeof total !== 'undefined') { %>
  <div class="pagination-info"><%= total %> asset(s) found</div>
  <%- include('../../partials/pagination') %>
<% } %>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
