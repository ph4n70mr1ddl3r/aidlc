<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div>
    <h2><%= isEdit ? 'Edit Asset' : 'New Asset' %></h2>
    <div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/assets">Assets</a> / <%= isEdit ? 'Edit' : 'New' %></div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <form action="<%= isEdit ? '/assets/' + asset.id + '?_method=PUT' : '/assets' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="form-group">
          <label for="asset_tag">Asset Tag *</label>
          <input type="text" name="asset_tag" id="asset_tag" class="form-control" value="<%= asset.asset_tag || '' %>" maxlength="<%= CONSTANTS.MAX_ASSET_TAG %>" required <% if (!isEdit) { %>readonly style="background:var(--bg);cursor:not-allowed;"<% } %>>
          <% if (!isEdit) { %><small class="text-muted">Auto-generated when the asset is created.</small><% } %>
        </div>
        <div class="form-group">
          <label for="name">Name *</label>
          <input type="text" name="name" id="name" class="form-control" value="<%= asset.name || '' %>" maxlength="<%= CONSTANTS.MAX_MEDIUM_STR %>" required>
        </div>
        <div class="form-group">
          <label for="category">Category *</label>
          <select name="category" id="category" class="form-control" required>
            <% CONSTANTS.ASSET_CATEGORIES.forEach(c => { %>
              <option value="<%= c %>" <%= asset.category === c ? 'selected' : '' %>><%= titleCase(c) %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="manufacturer">Manufacturer</label>
          <input type="text" name="manufacturer" id="manufacturer" class="form-control" value="<%= asset.manufacturer || '' %>" maxlength="<%= CONSTANTS.MAX_SHORT_STR %>">
        </div>
        <div class="form-group">
          <label for="model">Model</label>
          <input type="text" name="model" id="model" class="form-control" value="<%= asset.model || '' %>" maxlength="<%= CONSTANTS.MAX_SHORT_STR %>">
        </div>
        <div class="form-group">
          <label for="serial_number">Serial Number</label>
          <input type="text" name="serial_number" id="serial_number" class="form-control" value="<%= asset.serial_number || '' %>" maxlength="<%= CONSTANTS.MAX_SHORT_STR %>" autocomplete="off">
        </div>
        <div class="form-group">
          <label for="status">Status</label>
          <select name="status" id="status" class="form-control">
            <% CONSTANTS.ASSET_STATUSES.forEach(s => { %>
              <option value="<%= s %>" <%= (asset.status || 'in_storage') === s ? 'selected' : '' %>><%= titleCase(s) %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="condition_rating">Condition</label>
          <select name="condition_rating" id="condition_rating" class="form-control">
            <% CONSTANTS.ASSET_CONDITIONS.forEach(c => { %>
              <option value="<%= c %>" <%= (asset.condition_rating || 'good') === c ? 'selected' : '' %>><%= titleCase(c) %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="purchase_date">Purchase Date</label>
          <input type="date" name="purchase_date" id="purchase_date" class="form-control" value="<%= asset.purchase_date ? asset.purchase_date.slice(0,10) : '' %>">
        </div>
        <div class="form-group">
          <label for="purchase_price">Purchase Price ($)</label>
          <input type="number" name="purchase_price" id="purchase_price" class="form-control" step="0.01" min="0" max="99999999.99" value="<%= asset.purchase_price != null ? asset.purchase_price : '' %>">
        </div>
        <div class="form-group">
          <label for="warranty_expiry">Warranty Expiry</label>
          <input type="date" name="warranty_expiry" id="warranty_expiry" class="form-control" value="<%= asset.warranty_expiry ? asset.warranty_expiry.slice(0,10) : '' %>">
        </div>
        <div class="form-group">
          <label for="assigned_to">Assigned To</label>
          <select name="assigned_to" id="assigned_to" class="form-control">
            <option value="">Unassigned</option>
            <% if (typeof staff !== 'undefined') { staff.forEach(s => { %>
              <option value="<%= s.id %>" <%= Number(asset.assigned_to) === Number(s.id) ? 'selected' : '' %>><%= s.first_name %> <%= s.last_name %></option>
            <% }) } %>
          </select>
        </div>
        <div class="form-group">
          <label for="location">Location</label>
          <input type="text" name="location" id="location" class="form-control" value="<%= asset.location || '' %>" maxlength="<%= CONSTANTS.MAX_SHORT_STR %>">
        </div>
      </div>
      <div class="form-group">
        <label for="notes">Notes</label>
        <textarea name="notes" id="notes" class="form-control" maxlength="<%= CONSTANTS.MAX_NOTES %>"><%= asset.notes || '' %></textarea>
      </div>
      <div style="margin-top:20px;display:flex;gap:12px;">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= isEdit ? 'Update Asset' : 'Create Asset' %></button>
        <a href="/assets" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
