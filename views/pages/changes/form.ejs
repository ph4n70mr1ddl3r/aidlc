<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header"><div><h2><%= isEdit ? 'Edit Change' : 'New Change' %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/changes">Changes</a> / <%= isEdit ? 'Edit' : 'New' %></div></div></div>
<div class="card"><div class="card-body">
  <form action="<%= isEdit ? '/changes/' + change.id + '?_method=PUT' : '/changes' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="form-group" style="grid-column:1/-1;"><label for="title">Title *</label><input type="text" name="title" id="title" class="form-control" value="<%= change.title || '' %>" maxlength="200" required></div>
      <div class="form-group" style="grid-column:1/-1;"><label for="description">Description</label><textarea name="description" id="description" class="form-control" maxlength="5000"><%= change.description || '' %></textarea></div>
      <div class="form-group"><label for="change_type">Type *</label><select name="change_type" id="change_type" class="form-control" required>
        <% CONSTANTS.CHANGE_TYPES.forEach(t => { %><option value="<%= t %>" <%= change.change_type === t ? 'selected' : '' %>><%= t.charAt(0).toUpperCase() + t.slice(1) %></option><% }) %>
      </select></div>
      <div class="form-group"><label for="status">Status</label><select name="status" id="status" class="form-control" required>
        <% CONSTANTS.CHANGE_STATUSES.forEach(s => { %><option value="<%= s %>" <%= (change.status || 'scheduled') === s ? 'selected' : '' %>><%= s %></option><% }) %>
      </select></div>
      <div class="form-group"><label for="priority">Priority</label><select name="priority" id="priority" class="form-control" required>
        <% CONSTANTS.CHANGE_PRIORITIES.forEach(p => { %><option value="<%= p %>" <%= (change.priority || 'medium') === p ? 'selected' : '' %>><%= p %></option><% }) %>
      </select></div>
      <div class="form-group"><label for="assigned_to">Assigned To</label><select name="assigned_to" id="assigned_to" class="form-control">
        <option value="">Unassigned</option><% staff.forEach(s => { %><option value="<%= s.id %>" <%= change.assigned_to == s.id ? 'selected' : '' %>><%= s.first_name %> <%= s.last_name %></option><% }) %>
      </select></div>
      <div class="form-group"><label for="scheduled_start">Scheduled Start</label><input type="datetime-local" name="scheduled_start" id="scheduled_start" class="form-control" value="<%= change.scheduled_start ? change.scheduled_start.slice(0,16) : '' %>"></div>
      <div class="form-group"><label for="scheduled_end">Scheduled End</label><input type="datetime-local" name="scheduled_end" id="scheduled_end" class="form-control" value="<%= change.scheduled_end ? change.scheduled_end.slice(0,16) : '' %>"></div>
      <% if (isEdit) { %>
      <div class="form-group"><label for="actual_start">Actual Start</label><input type="datetime-local" name="actual_start" id="actual_start" class="form-control" value="<%= change.actual_start ? change.actual_start.slice(0,16) : '' %>"></div>
      <div class="form-group"><label for="actual_end">Actual End</label><input type="datetime-local" name="actual_end" id="actual_end" class="form-control" value="<%= change.actual_end ? change.actual_end.slice(0,16) : '' %>"></div>
      <% } %>
      <div class="form-group" style="grid-column:1/-1;"><label for="impact">Impact</label><textarea name="impact" id="impact" class="form-control" rows="2" maxlength="500"><%= change.impact || '' %></textarea></div>
    </div>
    <div style="margin-top:20px;display:flex;gap:12px;">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= isEdit ? 'Update' : 'Create' %></button>
      <a href="/changes" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div></div>
<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
