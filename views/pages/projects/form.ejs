<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div><h2><%= isEdit ? 'Edit Project' : 'New Project' %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/projects">Projects</a> / <%= isEdit ? 'Edit' : 'New' %></div></div>
</div>

<div class="card"><div class="card-body">
  <form action="<%= isEdit ? '/projects/' + project.id + '?_method=PUT' : '/projects' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="form-group" style="grid-column:1/-1;"><label>Project Name *</label><input type="text" name="name" class="form-control" value="<%= project.name || '' %>" maxlength="200" required></div>
      <div class="form-group" style="grid-column:1/-1;"><label>Description</label><textarea name="description" class="form-control" rows="3" maxlength="5000"><%= project.description || '' %></textarea></div>
      <div class="form-group"><label>Status</label><select name="status" class="form-control">
        <% CONSTANTS.PROJECT_STATUSES.forEach(s => { %>
          <option value="<%= s %>" <%= (project.status || 'planning') === s ? 'selected' : '' %>><%= s.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %></option>
        <% }) %>
      </select></div>
      <div class="form-group"><label>Priority</label><select name="priority" class="form-control">
        <% CONSTANTS.PROJECT_PRIORITIES.forEach(p => { %>
          <option value="<%= p %>" <%= (project.priority || 'medium') === p ? 'selected' : '' %>><%= p.charAt(0).toUpperCase() + p.slice(1) %></option>
        <% }) %>
      </select></div>
      <div class="form-group"><label>Start Date</label><input type="date" name="start_date" class="form-control" value="<%= project.start_date ? project.start_date.slice(0,10) : '' %>"></div>
      <div class="form-group"><label>End Date</label><input type="date" name="end_date" class="form-control" value="<%= project.end_date ? project.end_date.slice(0,10) : '' %>"></div>
      <div class="form-group"><label>Budget ($)</label><input type="number" name="budget" class="form-control" step="0.01" min="0" value="<%= project.budget != null ? project.budget : '' %>"></div>
      <div class="form-group"><label>Spent ($)</label><input type="number" name="spent" class="form-control" step="0.01" min="0" value="<%= project.spent != null ? project.spent : '' %>"></div>
      <div class="form-group"><label>Owner</label><select name="owner_id" class="form-control">
        <option value="">Select owner</option>
        <% staff.forEach(s => { %><option value="<%= s.id %>" <%= project.owner_id == s.id ? 'selected' : '' %>><%= s.first_name %> <%= s.last_name %></option><% }) %>
      </select></div>
    </div>
    <div style="margin-top:20px;display:flex;gap:12px;">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= isEdit ? 'Update' : 'Create' %> Project</button>
      <a href="/projects" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div></div>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
