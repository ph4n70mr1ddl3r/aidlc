<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div><h2><%= project.name %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/projects">Projects</a> / <%= project.name %></div></div>
  <% if (isPrivileged(user)) { %>
  <div class="flex gap-2">
    <a href="/projects/<%= project.id %>/edit" class="btn btn-secondary"><i class="fas fa-edit"></i> Edit</a>
    <form action="/projects/<%= project.id %>?_method=DELETE" method="POST" style="display:inline;" data-confirm="Delete this project and all tasks?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Delete</button>
    </form>
  </div>
  <% } %>
</div>

<!-- Project Header -->
<div class="card mb-3">
  <div class="card-body">
    <div class="flex justify-between items-center mb-2">
      <div>
        <span class="badge badge-<%= project.status %>" style="font-size:14px;padding:6px 16px;"><%= titleCase(project.status) %></span>
        <span class="badge badge-<%= project.priority %>" style="font-size:14px;padding:6px 16px;"><%= titleCase(project.priority) %></span>
      </div>
      <div class="text-sm text-muted">
        Owner: <strong><%= project.owner_name || 'Unassigned' %></strong> | 
        <%= project.start_date ? formatDate(project.start_date) : 'TBD' %> — <%= project.end_date ? formatDate(project.end_date) : 'TBD' %>
      </div>
    </div>
    <% if (project.description) { %><p class="text-sm" style="margin-bottom:16px;"><%= project.description %></p><% } %>
    <div class="flex items-center gap-2">
      <span class="text-sm"><strong>Progress: <%= project.progress || 0 %>%</strong></span>
      <div class="progress-bar" role="progressbar" aria-valuenow="<%= project.progress || 0 %>" aria-valuemin="0" aria-valuemax="100" aria-label="Project progress: <%= project.progress || 0 %>%" style="flex:1;">
        <div class="progress-fill <%= (project.progress || 0) >= CONSTANTS.PROGRESS_GREEN_THRESHOLD ? 'green' : (project.progress || 0) >= CONSTANTS.PROGRESS_BLUE_THRESHOLD ? 'blue' : (project.progress || 0) >= CONSTANTS.PROGRESS_ORANGE_THRESHOLD ? 'orange' : 'red' %>" style="width:<%= project.progress || 0 %>%"></div>
      </div>
      <% if (project.budget != null && project.budget > 0) { %>
        <span class="text-sm text-muted"><%= project.spent != null ? '$' + Number(project.spent).toLocaleString() : '-' %> / $<%= Number(project.budget).toLocaleString() %></span>
      <% } %>
    </div>
  </div>
</div>

<div class="grid-2-1">
  <!-- Tasks -->
  <div class="card">
    <div class="card-header">
      <!-- "N+" when the 200-task cap was hit — the list is a capped subset. -->
      <h3><i class="fas fa-tasks" style="margin-right:8px;color:var(--primary)"></i>Tasks (<%= tasks.length %><%= tasks.length >= CONSTANTS.TASK_LIST_CAP ? '+' : '' %>)</h3>
    </div>
    <div class="card-body">
      <!-- Add Task -->
      <% if (isPrivileged(user)) { %>
      <form action="/projects/<%= project.id %>/tasks" method="POST" class="mb-3" style="display:flex;gap:8px;flex-wrap:wrap;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="text" name="title" class="form-control" placeholder="New task title..." style="flex:1;min-width:200px;" maxlength="<%= CONSTANTS.MAX_MEDIUM_STR %>" required>
        <select name="priority" class="form-control" style="width:120px;">
          <% CONSTANTS.TASK_PRIORITIES.forEach(p => { %><option value="<%= p %>" <%= p === 'medium' ? 'selected' : '' %>><%= titleCase(p) %></option><% }) %>
        </select>
        <select name="assigned_to" class="form-control" style="width:160px;">
          <option value="">Unassigned</option>
          <% if (typeof staff !== 'undefined') { staff.forEach(s => { %><option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %></option><% }); } %>
        </select>
        <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Add</button>
      </form>
      <% } %>

      <!-- Task List -->
      <% tasks.forEach(t => { %>
      <div style="padding:12px;border:1px solid var(--border);border-radius:8px;margin-bottom:8px;" class="flex items-center gap-2">
        <form action="/projects/<%= project.id %>/tasks/<%= t.id %>?_method=PUT" method="POST" style="display:flex;align-items:center;gap:8px;flex:1;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="_quick_status" value="1">
          <select name="status" class="form-control" style="width:120px;padding:4px 28px 4px 8px;font-size:12px;" data-auto-submit <% if (!isPrivileged(user)) { %>disabled<% } %>>
            <% CONSTANTS.TASK_STATUSES.forEach(s => { %>
            <option value="<%= s %>" <%= t.status === s ? 'selected' : '' %>><%= titleCase(s) %></option>
            <% }) %>
          </select>
          <span style="flex:1;font-size:14px;<%= t.status === 'done' ? 'text-decoration:line-through;color:var(--text-light);' : '' %>">
            <strong><%= t.title %></strong>
            <span class="text-sm text-muted"> — <%= t.assigned_name || 'Unassigned' %></span>
            <% if (t.due_date && t.status !== 'done') { %>
              <% const _tDays = daysUntil(t.due_date); if (_tDays !== null) { %>
              <% if (_tDays < 0) { %><span class="badge badge-critical" style="margin-left:4px;">Overdue</span>
              <% } else if (_tDays <= 3) { %><span class="badge badge-high" style="margin-left:4px;">Due soon</span><% } %>
              <% } %>
            <% } %>
          </span>
          <span class="badge badge-<%= t.priority %>"><%= titleCase(t.priority) %></span>
          <% if (t.due_date) { %><span class="text-sm text-muted"><%= formatDate(t.due_date) %></span><% } %>
        </form>
        <% if (isPrivileged(user)) { %><form action="/projects/<%= project.id %>/tasks/<%= t.id %>?_method=DELETE" method="POST" data-confirm="Delete task?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-sm btn-outline" style="color:var(--danger);" aria-label="Delete task <%= t.title %>"><i class="fas fa-times"></i></button>
        </form><% } %>
      </div>
      <% }) %>
      <% if (tasks.length === 0) { %><p class="text-muted text-sm">No tasks yet. Add one above.</p><% } %>
    </div>
  </div>

  <!-- Sidebar -->
  <div>
    <div class="card mb-2">
      <div class="card-header">      <!-- "N+" when the 100-member cap was hit — the list is a capped subset. -->
      <h3><i class="fas fa-users" style="margin-right:8px;color:var(--primary)"></i>Team (<%= members.length %><%= members.length >= CONSTANTS.MEMBER_LIST_CAP ? '+' : '' %>)</h3></div>
      <div class="card-body">
        <% if (isPrivileged(user)) { %>
        <form action="/projects/<%= project.id %>/members" method="POST" class="flex gap-2 mb-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <select name="user_id" class="form-control" style="flex:1;" required>
            <option value="">Add member...</option>
          <% if (typeof staff !== 'undefined') { staff.forEach(s => { %><option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %></option><% }); } %>
          </select>
          <select name="role" class="form-control" style="width:120px;">
            <% CONSTANTS.MEMBER_ROLES.forEach(r => { %><option value="<%= r %>" <%= r === 'member' ? 'selected' : '' %>><%= titleCase(r) %></option><% }) %>
          </select>
          <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-plus"></i></button>
        </form>
        <% } %>
        <% members.forEach(m => { %>
        <div class="flex items-center justify-between" style="padding:8px 0;border-bottom:1px solid var(--border);">
          <div>
            <div class="text-sm" style="font-weight:600;"><%= m.member_name %></div>
            <div class="text-sm text-muted"><%= titleCase(m.role) %></div>
          </div>
          <% if (isPrivileged(user)) { %><form action="/projects/<%= project.id %>/members/<%= m.id %>?_method=DELETE" method="POST" data-confirm="Remove this member from the project?">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-outline" style="color:var(--danger);padding:2px 6px;" aria-label="Remove <%= m.member_name %>"><i class="fas fa-times"></i></button>
          </form><% } %>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
