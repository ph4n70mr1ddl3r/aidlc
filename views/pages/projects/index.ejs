<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div><h2>Projects <span class="text-sm text-muted" style="font-weight:normal;">(<%= total %> total)</span></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / Projects</div></div>
  <% if (isPrivileged(user)) { %>
  <a href="/projects/new" class="btn btn-primary"><i class="fas fa-plus" aria-hidden="true"></i> New Project</a>
  <% } %>
</div>

<form method="GET" action="/projects" class="filter-bar">
  <input type="text" name="search" class="search-input" autocomplete="off" placeholder="Search projects..." aria-label="Search projects" value="<%= filters.search || '' %>" maxlength="<%= CONSTANTS.MAX_SEARCH %>">
  <select name="status" aria-label="Filter by status">
    <option value="">All Status</option>
    <% CONSTANTS.PROJECT_STATUSES.forEach(s => { %>
      <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= titleCase(s) %></option>
    <% }) %>
  </select>
  <select name="priority" aria-label="Filter by priority">
    <option value="">All Priority</option>
    <% CONSTANTS.PROJECT_PRIORITIES.forEach(p => { %>
      <option value="<%= p %>" <%= filters.priority === p ? 'selected' : '' %>><%= titleCase(p) %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search" aria-hidden="true"></i> Filter</button>
  <a href="/projects" class="btn btn-sm btn-outline">Clear</a>
</form>

<div class="grid-2">
  <% projects.forEach(p => {
  // Link the card title only when the viewer can open the ownership-gated
  // show route (privileged or owner) — an unconditional link guaranteed an
  // access_denied flash + audit entry on routine staff navigation. Unlinked
  // cards keep portfolio visibility.
  const canView = isPrivileged(user) || Number(p.owner_id) === Number(user.id); %>
  <div class="card">
    <div class="card-body">
      <div class="flex justify-between items-center mb-1">
        <% if (canView) { %><a href="/projects/<%= p.id %>" style="font-size:16px;font-weight:600;color:var(--text);text-decoration:none;"><%= p.name %></a><% } else { %><span style="font-size:16px;font-weight:600;"><%= p.name %></span><% } %>
        <span class="badge badge-<%= p.status %>"><%= titleCase(p.status) %></span>
      </div>
      <p class="text-sm text-muted mb-2"><%= (p.description || '').substring(0, CONSTANTS.DESC_TRUNCATION_LEN) %><%= (p.description || '').length > CONSTANTS.DESC_TRUNCATION_LEN ? '...' : '' %></p>
      <div class="flex justify-between items-center mb-1">
        <span class="text-sm">Progress</span>
        <span class="text-sm" style="font-weight:600"><%= p.progress || 0 %>%</span>
      </div>
      <div class="progress-bar mb-2" role="progressbar" aria-valuenow="<%= p.progress || 0 %>" aria-valuemin="0" aria-valuemax="100" aria-label="Project progress: <%= p.progress || 0 %>%" style="flex:1;">
        <div class="progress-fill <%= (p.progress || 0) >= CONSTANTS.PROGRESS_GREEN_THRESHOLD ? 'green' : (p.progress || 0) >= CONSTANTS.PROGRESS_BLUE_THRESHOLD ? 'blue' : (p.progress || 0) >= CONSTANTS.PROGRESS_ORANGE_THRESHOLD ? 'orange' : 'red' %>" style="width:<%= p.progress || 0 %>%"></div>
      </div>
      <div class="flex justify-between text-sm text-muted">
        <span><i class="fas fa-user" aria-hidden="true"></i> <%= p.owner_name || 'Unassigned' %></span>
        <span><i class="fas fa-tasks" aria-hidden="true"></i> <%= p.done_count || 0 %>/<%= p.task_count || 0 %> tasks</span>
      </div>
      <% if (p.start_date || p.end_date) { %>
      <div class="text-sm text-muted mt-1">
        <i class="fas fa-calendar" aria-hidden="true"></i> <%= p.start_date ? formatDate(p.start_date) : '?' %> — <%= p.end_date ? formatDate(p.end_date) : '?' %>
      </div>
      <% } %>
      <% // Budget/spent are financial data gated to privileged users — the same
         // business-sensitivity policy licenses.js applies to cost/seats (the
         // license list route is requireAdminOrManager for exactly this reason). %>
      <% if (isPrivileged(user) && p.budget != null && p.budget > 0) { %>
      <div class="text-sm text-muted mt-1">
        <i class="fas fa-dollar-sign" aria-hidden="true"></i> <%= p.spent != null ? '$' + Number(p.spent).toLocaleString() : '-' %> / $<%= Number(p.budget).toLocaleString() %>
      </div>
      <% } %>
    </div>
  </div>
  <% }) %>
  <% if (projects.length === 0) { %>
    <div class="empty-state" style="grid-column:1/-1;"><i class="fas fa-project-diagram" aria-hidden="true"></i><h3>No projects found</h3><p>Create your first project or adjust filters</p></div>
  <% } %>
</div>

<%- include('../../partials/pagination') %>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
