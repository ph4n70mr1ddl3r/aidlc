<%- include('../partials/header') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:var(--bg);">
  <div style="text-align:center;">
    <h1 style="font-size:96px;font-weight:800;color:var(--primary);line-height:1;">404</h1>
    <h2 style="margin-bottom:12px;">Page Not Found</h2>
    <p class="text-muted" style="margin-bottom:24px;">The page you're looking for doesn't exist.</p>
    <% // The CTA follows the auth-gating convention used everywhere else:
       // signed-in visitors get "Go to Dashboard"; anonymous visitors get
       // "Go to Login" (an unconditional dashboard link would bounce through
       // / to /login while claiming to go to the dashboard). `user` is guarded
       // because this page can also render for requests that errored BEFORE the
       // res.locals middleware ran (same reason header.ejs guards csrfToken). %>
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/dashboard" class="btn btn-primary"><i class="fas fa-home" aria-hidden="true"></i> Go to Dashboard</a>
    <% } else { %>
      <a href="/login" class="btn btn-primary"><i class="fas fa-sign-in-alt" aria-hidden="true"></i> Go to Login</a>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
