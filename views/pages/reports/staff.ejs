<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header">
  <div><h2>Staff Performance</h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/reports">Reports</a> / Staff</div></div>
  <form method="GET" action="/reports/staff" class="flex items-center gap-2">
    <select name="period" class="form-control" style="width:160px;" onchange="this.form.submit()" aria-label="Report period">
      <option value="7" <%= String(period) === '7' ? 'selected' : '' %>>Last 7 days</option>
      <option value="30" <%= String(period) === '30' ? 'selected' : '' %>>Last 30 days</option>
      <option value="90" <%= String(period) === '90' ? 'selected' : '' %>>Last 90 days</option>
      <option value="365" <%= String(period) === '365' ? 'selected' : '' %>>Last year</option>
    </select>
  </form>
</div>

<div class="card"><div class="card-body" style="padding:0;">
  <div class="table-responsive"><table>
    <thead><tr><th>Staff Member</th><th>Role</th><th>Open Tickets</th><th>Resolved</th><th>Avg Resolution</th><th>Tasks Done</th><th>Workload</th></tr></thead>
    <tbody><% performance.forEach(p => { %><tr>
      <td><a href="/staff/<%= p.id %>" style="color:var(--text);text-decoration:none;font-weight:600;"><%= p.name %></a></td>
      <td><span class="badge badge-<%= p.role === 'admin' ? 'critical' : p.role === 'manager' ? 'high' : 'medium' %>"><%= p.role %></span></td>
      <td class="text-center"><%= p.open_tickets %></td>
      <td class="text-center"><%= p.resolved_tickets || 0 %></td>
      <td class="text-center"><%= p.avg_resolution_days ? Number(p.avg_resolution_days).toFixed(1) + ' days' : 'N/A' %></td>
      <td class="text-center"><%= p.completed_tasks || 0 %></td>
      <td><div class="progress-bar" style="width:100px;display:inline-block;vertical-align:middle;">
        <div class="progress-fill <%= p.open_tickets > 5 ? 'red' : p.open_tickets > 3 ? 'orange' : 'green' %>" style="width:<%= Math.min(p.open_tickets * 15, 100) %>%"></div>
      </div></td>
    </tr><% }) %></tbody>
  </table></div>
</div></div>

<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
