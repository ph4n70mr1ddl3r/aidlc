<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header"><div><h2>Asset Report</h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/reports">Reports</a> / Assets</div></div></div>

<div class="stats-grid">
  <div class="stat-card"><div class="stat-icon blue"><i class="fas fa-box" aria-hidden="true"></i></div><div><div class="stat-value"><%= byCategory.reduce((a,b) => a + b.count, 0) %></div><div class="stat-label">Active Assets</div></div></div>
  <div class="stat-card"><div class="stat-icon green"><i class="fas fa-dollar-sign" aria-hidden="true"></i></div><div><div class="stat-value"><%= totalValue.total ? '$' + Number(totalValue.total).toLocaleString() : '-' %></div><div class="stat-label">Total Value</div></div></div>
  <div class="stat-card"><div class="stat-icon orange"><i class="fas fa-shield-alt" aria-hidden="true"></i></div><div><div class="stat-value"><%= warrantyCount %></div><div class="stat-label">Warranty Ending (90d)</div></div></div>
</div>

<div class="grid-2">
  <div class="card"><div class="card-header"><h3>By Category</h3></div><div class="card-body">
    <% const assetTotal = byCategory.reduce((a,b) => a + b.count, 0); %>
    <% byCategory.forEach(c => { const pct = assetTotal > 0 ? Math.round(c.count/assetTotal*100) : 0; %>
    <div style="margin-bottom:12px;">
      <div class="flex justify-between text-sm mb-1"><span><%= titleCase(c.category) %></span><span><%= c.count %> · <%= c.total_value ? '$' + Number(c.total_value).toLocaleString() : '-' %></span></div>
      <div class="progress-bar" role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= titleCase(c.category) %>: <%= c.count %> assets"><div class="progress-fill blue" style="width:<%= pct %>%"></div></div>
    </div><% }) %>
    <% if (!byCategory.length) { %><p class="text-muted text-sm">No data for this period</p><% } %>
  </div></div>
  <div class="card"><div class="card-header"><h3>By Status</h3></div><div class="card-body">
    <% const statusTotal = byStatus.reduce((a,b) => a + b.count, 0); %>
    <% byStatus.forEach(s => { const pct = statusTotal > 0 ? Math.round(s.count/statusTotal*100) : 0; %>
    <div style="margin-bottom:12px;">
      <div class="flex justify-between text-sm mb-1"><span><%= titleCase(s.status) %></span><span><%= s.count %> (<%= pct %>%)</span></div>
      <div class="progress-bar" role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= titleCase(s.status) %>: <%= s.count %> assets"><div class="progress-fill green" style="width:<%= pct %>%"></div></div>
    </div><% }) %>
    <% if (!byStatus.length) { %><p class="text-muted text-sm">No data for this period</p><% } %>
  </div></div>
  <div class="card"><div class="card-header"><h3>By Condition</h3></div><div class="card-body">
    <% const condTotal = byCondition.reduce((a,b) => a + b.count, 0); %>
    <% byCondition.forEach(c => { const pct = condTotal > 0 ? Math.round(c.count/condTotal*100) : 0; const _bc = badgeClass(c.condition_rating || 'good', CONDITION_BADGE); %>
    <div style="margin-bottom:12px;">
      <div class="flex justify-between text-sm mb-1"><span><%= titleCase(c.condition_rating || 'good') %></span><span><%= c.count %> (<%= pct %>%)</span></div>
      <div class="progress-bar" role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= titleCase(c.condition_rating) %>: <%= c.count %> assets">      <div class="progress-fill <%= _bc === 'low' ? 'green' : _bc === 'medium' ? 'orange' : 'red' %>" style="width:<%= pct %>%"></div></div>
    </div><% }) %>
    <% if (!byCondition.length) { %><p class="text-muted text-sm">No data for this period</p><% } %>
  </div></div>
  <div class="card"><div class="card-header"><h3>Age Distribution</h3></div><div class="card-body">
    <% const ageTotal = ageDistribution.reduce((x,y) => x + y.count, 0); %>
    <% ageDistribution.forEach(a => { const pct = ageTotal > 0 ? Math.round(a.count/ageTotal*100) : 0; %>
    <div style="margin-bottom:12px;">
      <div class="flex justify-between text-sm mb-1"><span><%= a.age_group %></span><span><%= a.count %> (<%= pct %>%)</span></div>
      <div class="progress-bar" role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= a.age_group %>: <%= a.count %> assets"><div class="progress-fill blue" style="width:<%= pct %>%"></div></div>
    </div><% }) %>
    <% if (!ageDistribution.length) { %><p class="text-muted text-sm">No data for this period</p><% } %>
  </div></div>
</div>

<% if (warrantyExpiring.length > 0) { %>
<div class="card mt-3"><div class="card-header"><h3>Warranty Ending or Expired (90 days)</h3></div><div class="card-body" style="padding:0;">
  <% if (warrantyCount > warrantyExpiring.length) { %><p class="text-muted text-sm" style="padding:12px;">Showing the soonest <%= warrantyExpiring.length %> of <%= warrantyCount %> assets.</p><% } %>
  <div class="table-responsive"><table>
    <thead><tr><th>Asset</th><th>Name</th><th>Warranty Expiry</th><th>Days Left</th></tr></thead>
    <tbody>    <% warrantyExpiring.forEach(a => { 
      const days = daysUntil(a.warranty_expiry);
    %><tr>
      <td style="font-weight:600;"><%= a.asset_tag %></td>
      <td><%= a.name %></td>
      <td><%= formatDate(a.warranty_expiry) %></td>
      <td><% if (days === null) { %>-<% } else { %><span class="badge badge-<%= days <= 30 ? 'critical' : days <= 60 ? 'high' : 'medium' %>"><%= days < 0 ? 'Expired ' + Math.abs(days) + ' days ago' : days + ' days' %></span><% } %></td>
    </tr><% }) %></tbody>
  </table></div>
</div></div><% } %>

<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
