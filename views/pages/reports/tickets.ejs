<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header">
  <div><h2>Ticket Analytics</h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/reports">Reports</a> / Tickets</div></div>
  <form method="GET" class="flex items-center gap-2">
    <select name="period" class="form-control" style="width:160px;" onchange="this.form.submit()">
      <option value="7" <%= String(period) === '7' ? 'selected' : '' %>>Last 7 days</option>
      <option value="30" <%= String(period) === '30' ? 'selected' : '' %>>Last 30 days</option>
      <option value="90" <%= String(period) === '90' ? 'selected' : '' %>>Last 90 days</option>
      <option value="365" <%= String(period) === '365' ? 'selected' : '' %>>Last year</option>
    </select>
  </form>
</div>

<div class="stats-grid">
  <div class="stat-card"><div class="stat-icon blue"><i class="fas fa-ticket"></i></div><div><div class="stat-value"><%= byCategory.reduce((a,b) => a + b.count, 0) %></div><div class="stat-label">Total Tickets</div></div></div>
  <div class="stat-card"><div class="stat-icon green"><i class="fas fa-check-circle"></i></div><div><div class="stat-value"><%= slaStats.total_resolved || 0 %></div><div class="stat-label">Resolved</div></div></div>
  <div class="stat-card"><div class="stat-icon cyan"><i class="fas fa-clock"></i></div><div><div class="stat-value"><%= avgResolution.avg_days ? Number(avgResolution.avg_days).toFixed(1) + 'd' : 'N/A' %></div><div class="stat-label">Avg Resolution</div></div></div>
  <div class="stat-card"><div class="stat-icon orange"><i class="fas fa-chart-line"></i></div><div><div class="stat-value"><%= slaStats.total_resolved > 0 ? Math.round((slaStats.within_3d / slaStats.total_resolved) * 100) : 0 %>%</div><div class="stat-label">SLA (3-day)</div></div></div>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header"><h3>By Category</h3></div>
    <div class="card-body">
      <% byCategory.forEach(c => { const total = byCategory.reduce((a,b) => a + b.count, 0); const pct = total > 0 ? Math.round(c.count/total*100) : 0; %>
      <div style="margin-bottom:12px;">
        <div class="flex justify-between text-sm mb-1"><span><%= c.category %></span><span><%= c.count %> (<%= pct %>%)</span></div>
        <div class="progress-bar"><div class="progress-fill blue" style="width:<%= pct %>%"></div></div>
      </div><% }) %>
      <% if (!byCategory.length) { %><p class="text-muted text-sm">No data for this period</p><% } %>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><h3>By Priority</h3></div>
    <div class="card-body">
      <% byPriority.forEach(p => { const total = byPriority.reduce((a,b) => a + b.count, 0); const pct = total > 0 ? Math.round(p.count/total*100) : 0; %>
      <div style="margin-bottom:12px;">
        <div class="flex justify-between text-sm mb-1"><span><%= p.priority %></span><span><%= p.count %> (<%= pct %>%)</span></div>
        <div class="progress-bar"><div class="progress-fill <%= p.priority === 'critical' ? 'red' : p.priority === 'high' ? 'orange' : 'blue' %>" style="width:<%= pct %>%"></div></div>
      </div><% }) %>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header"><h3>Top Resolvers</h3></div>
  <div class="card-body" style="padding:0;">
    <div class="table-responsive"><table>
      <thead><tr><th>Staff Member</th><th>Tickets Resolved</th><th>Performance</th></tr></thead>
      <tbody><% topResolvers.forEach(r => { const max = topResolvers[0]?.resolved || 1; %><tr>
        <td style="font-weight:600;"><%= r.name %></td>
        <td><%= r.resolved %></td>
        <td><div class="progress-bar" style="width:150px;display:inline-block;vertical-align:middle;"><div class="progress-fill green" style="width:<%= Math.round(r.resolved/max*100) %>%"></div></div></td>
      </tr><% }) %></tbody>
    </table></div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header"><h3>SLA Performance</h3></div>
  <div class="card-body">
    <div class="stats-grid" style="margin-bottom:0;">
      <div class="stat-card"><div class="stat-value"><%= slaStats.within_1d || 0 %></div><div class="stat-label">Within 1 Day</div></div>
      <div class="stat-card"><div class="stat-value"><%= slaStats.within_3d || 0 %></div><div class="stat-label">Within 3 Days</div></div>
      <div class="stat-card"><div class="stat-value"><%= slaStats.within_7d || 0 %></div><div class="stat-label">Within 7 Days</div></div>
    </div>
  </div>
</div>

<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
