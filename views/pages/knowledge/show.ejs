<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header">
  <div><h2><%= article.title %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/knowledge">Knowledge Base</a> / <%= article.title %></div></div>
  <%
    const canManageArticle = Number(article.author_id) === Number(user.id) || isPrivileged(user);
  %>
  <% if (canManageArticle) { %>
  <div class="flex gap-2">
    <a href="/knowledge/<%= article.id %>/edit" class="btn btn-secondary"><i class="fas fa-edit" aria-hidden="true"></i> Edit</a>
    <form action="/knowledge/<%= article.id %>?_method=DELETE" method="POST" style="display:inline;" data-confirm="Delete this article?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-danger"><i class="fas fa-trash" aria-hidden="true"></i> Delete</button></form>
  </div>
  <% } %>
</div>
<div class="card mb-3"><div class="card-body" style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;">
  <span class="badge badge-<%= article.status %>"><%= titleCase(article.status) %></span>
  <span class="badge badge-<%= badgeClass(article.category || 'other', KB_CATEGORY_BADGE) %>"><%= titleCase(article.category || 'other') %></span>
  <span class="text-sm text-muted">By <strong><%= article.author_name %></strong></span>
  <span class="text-sm text-muted"><i class="fas fa-eye" aria-hidden="true"></i> <%= article.views %> views</span>
  <span class="text-sm text-muted"><i class="fas fa-clock" aria-hidden="true"></i> Updated <%= formatDateTime(article.updated_at) %></span>
  <% if (article.tags) { %><span class="text-sm text-muted"><i class="fas fa-tags" aria-hidden="true"></i> <%= article.tags %></span><% } %>
</div></div>
<div class="card"><div class="card-body">
  <% if (typeof markedFallback !== 'undefined' && markedFallback) { %>
  <div class="alert alert-warning mb-3"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i> Markdown rendering is unavailable. Article content is shown as plain text.</div>
  <% } %>
  <div class="article-content" style="font-size:15px;line-height:1.8;"><%- article.renderedContent %></div>
</div></div>
<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
