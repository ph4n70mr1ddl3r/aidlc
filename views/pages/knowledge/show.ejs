<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header">
  <div><h2><%= article.title %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/knowledge">Knowledge Base</a> / <%= article.title %></div></div>
  <%
    const canEditArticle = article.author_id === user.id || isPrivileged(user);
    const canDeleteArticle = isPrivileged(user);
  %>
  <% if (canEditArticle || canDeleteArticle) { %>
  <div class="flex gap-2">
    <% if (canEditArticle) { %><a href="/knowledge/<%= article.id %>/edit" class="btn btn-secondary"><i class="fas fa-edit"></i> Edit</a><% } %>
    <% if (canDeleteArticle) { %><form action="/knowledge/<%= article.id %>?_method=DELETE" method="POST" style="display:inline;" data-confirm="Delete this article?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Delete</button></form><% } %>
  </div>
  <% } %>
</div>
<div class="card mb-3"><div class="card-body" style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;">
  <span class="badge badge-<%= article.status %>"><%= titleCase(article.status) %></span>
  <span class="badge badge-medium"><%= titleCase(article.category) %></span>
  <span class="text-sm text-muted">By <strong><%= article.author_name %></strong></span>
  <span class="text-sm text-muted"><i class="fas fa-eye"></i> <%= article.views %> views</span>
  <span class="text-sm text-muted"><i class="fas fa-clock"></i> Updated <%= formatDateTime(article.updated_at) %></span>
  <% if (article.tags) { %><span class="text-sm text-muted"><i class="fas fa-tags"></i> <%= article.tags %></span><% } %>
</div></div>
<div class="card"><div class="card-body">
  <div class="article-content" style="font-size:15px;line-height:1.8;"><%- article.renderedContent %></div>
</div></div>
<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
