<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header"><div><h2><%= isEdit ? 'Edit Article' : 'New Article' %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/knowledge">Knowledge Base</a> / <%= isEdit ? 'Edit' : 'New' %></div></div></div>
<div class="card"><div class="card-body">
  <form action="<%= isEdit ? '/knowledge/' + article.id + '?_method=PUT' : '/knowledge' %>" method="POST">
    <div class="form-group"><label>Title *</label><input type="text" name="title" class="form-control" value="<%= article.title || '' %>" required></div>
    <div class="form-grid">
      <div class="form-group"><label>Category *</label><select name="category" class="form-control" required>
        <% ['how_to','troubleshooting','policy','faq','sop','other'].forEach(c => { %>
          <option value="<%= c %>" <%= article.category === c ? 'selected' : '' %>><%= c.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %></option>
        <% }) %>
      </select></div>
      <div class="form-group"><label>Status</label><select name="status" class="form-control">
        <option value="draft" <%= (article.status || 'draft') === 'draft' ? 'selected' : '' %>>Draft</option>
        <option value="published" <%= article.status === 'published' ? 'selected' : '' %>>Published</option>
        <option value="archived" <%= article.status === 'archived' ? 'selected' : '' %>>Archived</option>
      </select></div>
    </div>
    <div class="form-group"><label>Tags</label><input type="text" name="tags" class="form-control" value="<%= article.tags || '' %>" placeholder="Comma separated tags"></div>
    <div class="form-group"><label>Content *</label><textarea name="content" class="form-control" rows="15" style="font-family:monospace;font-size:13px;" required><%= article.content || '' %></textarea></div>
    <div class="form-group"><label><input type="checkbox" name="is_featured" value="1" <%= article.is_featured ? 'checked' : '' %>> Featured article</label></div>
    <div style="display:flex;gap:12px;margin-top:20px;">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= isEdit ? 'Update' : 'Create' %></button>
      <a href="/knowledge" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div></div>
<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
