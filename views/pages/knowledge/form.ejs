<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header"><div><h2><%= isEdit ? 'Edit Article' : 'New Article' %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/knowledge">Knowledge Base</a> / <%= isEdit ? 'Edit' : 'New' %></div></div></div>
<div class="card"><div class="card-body">
  <form action="<%= isEdit ? '/knowledge/' + article.id + '?_method=PUT' : '/knowledge' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group"><label for="title">Title *</label><input type="text" name="title" id="title" class="form-control" value="<%= article.title || '' %>" maxlength="200" required></div>
    <div class="form-grid">
      <div class="form-group"><label for="category">Category *</label><select name="category" id="category" class="form-control" required>
        <% CONSTANTS.KB_CATEGORIES.forEach(c => { %>
          <option value="<%= c %>" <%= article.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select></div>
      <div class="form-group"><label for="status">Status</label><select name="status" id="status" class="form-control">
        <% CONSTANTS.KB_STATUSES.forEach(s => { %>
          <option value="<%= s %>" <%= (article.status || 'draft') === s ? 'selected' : '' %>><%= titleCase(s) %></option>
        <% }) %>
      </select></div>
    </div>
    <div class="form-group"><label for="tags">Tags</label><input type="text" name="tags" id="tags" class="form-control" value="<%= article.tags || '' %>" maxlength="500" placeholder="Comma separated tags"></div>
    <div class="form-group"><label for="content">Content *</label><textarea name="content" id="content" class="form-control" rows="15" style="font-family:monospace;font-size:13px;" maxlength="50000" required><%= article.content || '' %></textarea></div>
    <div class="form-group"><% if (user.role === 'admin' || user.role === 'manager') { %><label><input type="checkbox" name="is_featured" value="1" <%= article.is_featured ? 'checked' : '' %>> Featured article</label><% } %></div>
    <div style="display:flex;gap:12px;margin-top:20px;">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= isEdit ? 'Update' : 'Create' %></button>
      <a href="/knowledge" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div></div>
<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
