<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div>
    <h2><%= ticket.ticket_number %></h2>
    <div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/tickets">Tickets</a> / <%= ticket.ticket_number %></div>
  </div>
  <div class="flex gap-2">
    <a href="/tickets/<%= ticket.id %>/edit" class="btn btn-secondary"><i class="fas fa-edit"></i> Edit</a>
    <% if (user.role === 'admin' || user.role === 'manager') { %>
    <form action="/tickets/<%= ticket.id %>?_method=DELETE" method="POST" style="display:inline;" 
          onsubmit="return confirm('Are you sure you want to delete this ticket?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Delete</button>
    </form>
    <% } %>
  </div>
</div>

<!-- Quick Status Actions -->
<div class="card mb-3">
  <div class="card-body" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
    <span style="font-weight:600;margin-right:8px;">Quick Status:</span>
    <% ['open','in_progress','waiting','resolved','closed'].forEach(s => { %>
      <% if (s !== ticket.status) { %>
        <form action="/tickets/<%= ticket.id %>/status?_method=PUT" method="POST" style="display:inline;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="status" value="<%= s %>">
          <button type="submit" class="btn btn-sm btn-outline"><%= s.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %></button>
        </form>
      <% } %>
    <% }) %>
    <span style="margin-left:auto;">
      <span class="badge badge-<%= ticket.status %>" style="font-size:14px;padding:6px 16px;">
        <%= ticket.status.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
      </span>
    </span>
  </div>
</div>

<div class="grid-2-1">
  <!-- Ticket Details -->
  <div>
    <div class="card mb-3">
      <div class="card-header"><h3><i class="fas fa-info-circle" style="margin-right:8px;color:var(--primary)"></i>Details</h3></div>
      <div class="card-body">
        <h4 style="margin-bottom:12px;"><%= ticket.title %></h4>
        <div style="white-space:pre-wrap;font-size:14px;color:var(--text-light);margin-bottom:20px;">
          <%= ticket.description || 'No description provided.' %>
        </div>
        <% if (ticket.resolution_notes) { %>
        <div style="background:var(--success-light);padding:12px;border-radius:8px;margin-top:16px;">
          <strong style="color:var(--success);">Resolution:</strong>
          <div style="white-space:pre-wrap;margin-top:4px;"><%= ticket.resolution_notes %></div>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Comments -->
    <div class="card">
      <div class="card-header"><h3><i class="fas fa-comments" style="margin-right:8px;color:var(--primary)"></i>Comments (<%= comments.length %>)</h3></div>
      <div class="card-body">
        <% comments.forEach(c => { %>
        <div class="comment <%= c.is_internal ? 'internal' : '' %>">
          <div class="comment-header">
            <div>
              <span class="comment-author"><%= c.author_name %></span>
              <span class="text-sm text-muted">(<%= c.author_role %>)</span>
              <% if (c.is_internal) { %><span class="badge badge-warning" style="margin-left:8px;">Internal</span><% } %>
            </div>
            <span class="comment-time"><%= new Date(c.created_at).toLocaleString() %></span>
          </div>
          <div class="comment-body"><%= c.comment %></div>
        </div>
        <% }) %>

        <!-- Add Comment Form -->
        <form action="/tickets/<%= ticket.id %>/comments" method="POST" style="margin-top:20px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label>Add Comment</label>
            <textarea name="comment" class="form-control" rows="3" placeholder="Type your comment..." maxlength="5000" required></textarea>
          </div>
          <div class="flex items-center gap-2">
            <% if (user.role === 'admin' || user.role === 'manager') { %>
            <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;">
              <input type="checkbox" name="is_internal" value="1"> Internal note (visible to IT staff only)
            </label>
            <% } %>
            <button type="submit" class="btn btn-primary" style="margin-left:auto;"><i class="fas fa-paper-plane"></i> Add Comment</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Sidebar Info -->
  <div>
    <div class="card mb-2">
      <div class="card-header"><h3><i class="fas fa-clipboard-list" style="margin-right:8px;color:var(--primary)"></i>Properties</h3></div>
      <div class="card-body" style="padding:0;">
        <div class="detail-row"><div class="detail-label">Ticket #</div><div class="detail-value" style="font-weight:600;"><%= ticket.ticket_number %></div></div>
        <div class="detail-row"><div class="detail-label">Priority</div><div class="detail-value"><span class="badge badge-<%= ticket.priority %>"><%= ticket.priority %></span></div></div>
        <div class="detail-row"><div class="detail-label">Category</div><div class="detail-value"><%= ticket.category %></div></div>
        <div class="detail-row"><div class="detail-label">Status</div><div class="detail-value"><span class="badge badge-<%= ticket.status %>"><%= ticket.status.replace(/_/g, ' ') %></span></div></div>
        <div class="detail-row"><div class="detail-label">Assigned To</div><div class="detail-value"><% if (ticket.assigned_name) { %><%= ticket.assigned_name %><% } else { %><span class="text-muted">Unassigned</span><% } %></div></div>
        <div class="detail-row"><div class="detail-label">Due Date</div><div class="detail-value"><% if (ticket.due_date) { %><%= new Date(ticket.due_date).toLocaleDateString() %><% } else { %><span class="text-muted">Not set</span><% } %></div></div>
        <div class="detail-row"><div class="detail-label">Asset</div><div class="detail-value"><% if (ticket.asset_name && ticket.asset_tag) { %><a href="/assets?search=<%= encodeURIComponent(ticket.asset_tag) %>" style="color:var(--primary);text-decoration:none;"><%= ticket.asset_tag %> - <%= ticket.asset_name %></a><% } else { %><span class="text-muted">None</span><% } %></div></div>
        <div class="detail-row"><div class="detail-label">Created</div><div class="detail-value"><%= new Date(ticket.created_at).toLocaleString() %></div></div>
        <div class="detail-row"><div class="detail-label">Updated</div><div class="detail-value"><%= new Date(ticket.updated_at).toLocaleString() %></div></div>
        <% if (ticket.resolved_at) { %>
        <div class="detail-row"><div class="detail-label">Resolved</div><div class="detail-value"><%= new Date(ticket.resolved_at).toLocaleString() %></div></div>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3><i class="fas fa-user" style="margin-right:8px;color:var(--primary)"></i>Requester</h3></div>
      <div class="card-body" style="padding:0;">
        <div class="detail-row"><div class="detail-label">Name</div><div class="detail-value"><%= ticket.requester_name %></div></div>
        <div class="detail-row"><div class="detail-label">Email</div><div class="detail-value"><a href="mailto:<%= ticket.requester_email %>"><%= ticket.requester_email %></a></div></div>
        <div class="detail-row"><div class="detail-label">Department</div><div class="detail-value"><%= ticket.requester_department || '-' %></div></div>
        <div class="detail-row"><div class="detail-label">Phone</div><div class="detail-value"><%= ticket.requester_phone || '-' %></div></div>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
