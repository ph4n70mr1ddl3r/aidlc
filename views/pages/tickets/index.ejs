<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div>
    <h2>Tickets <span class="text-sm text-muted" style="font-weight:normal;">(<%= total %> total)</span></h2>
    <div class="breadcrumb"><a href="/dashboard">Dashboard</a> / Tickets</div>
  </div>
  <a href="/tickets/new" class="btn btn-primary"><i class="fas fa-plus"></i> New Ticket</a>
</div>

<!-- Filters -->
<form method="GET" action="/tickets" class="filter-bar">
  <input type="text" name="search" class="search-input" autocomplete="off" placeholder="Search tickets..." aria-label="Search tickets" value="<%= filters.search || '' %>" maxlength="<%= CONSTANTS.MAX_SEARCH %>">
  <select name="status" aria-label="Filter by status">
    <option value="">All Status</option>
    <% CONSTANTS.TICKET_STATUSES.forEach(s => { %>
    <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= titleCase(s) %></option>
    <% }) %>
  </select>
  <select name="priority" aria-label="Filter by priority">
    <option value="">All Priority</option>
    <% CONSTANTS.TICKET_PRIORITIES.forEach(p => { %>
    <option value="<%= p %>" <%= filters.priority === p ? 'selected' : '' %>><%= titleCase(p) %></option>
    <% }) %>
  </select>
  <select name="category" aria-label="Filter by category">
    <option value="">All Categories</option>
    <% CONSTANTS.TICKET_CATEGORIES.forEach(c => { %>
    <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= titleCase(c) %></option>
    <% }) %>
  </select>
  <select name="assigned_to" aria-label="Filter by assignee">
    <option value="">All Assignees</option>
    <% if (typeof staff !== 'undefined') { staff.forEach(s => { %>
      <option value="<%= s.id %>" <%= Number(filters.assigned_to) === Number(s.id) ? 'selected' : '' %>><%= s.first_name %> <%= s.last_name %></option>
    <% }) } %>
  </select>
  <select name="sort" aria-label="Sort order">
    <option value="newest" <%= filters.sort === 'newest' || !filters.sort ? 'selected' : '' %>>Newest First</option>
    <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
    <option value="priority" <%= filters.sort === 'priority' ? 'selected' : '' %>>Priority</option>
  </select>
  <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i> Filter</button>
  <a href="/tickets" class="btn btn-sm btn-outline">Clear</a>
</form>

<div class="card">
  <div class="card-body" style="padding:0;">
    <% if (tickets.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-ticket"></i>
        <h3>No tickets found</h3>
        <p>Create a new ticket or adjust your filters</p>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table>
        <thead><tr><th>Ticket</th><th>Title</th><th>Requester</th><th>Category</th><th>Priority</th><th>Status</th><th>Assigned To</th><th>Created</th><th>Actions</th></tr></thead>
      <tbody>
        <% tickets.forEach(t => {
        // Link rows only when the viewer can actually open the show route —
        // staff are denied there unless the ticket is assigned to them, so an
        // unconditional link guaranteed an access_denied flash + audit entry on
        // every routine click. Unlinked rows still keep queue visibility.
        const canView = isPrivileged(user) || Number(t.assigned_to) === Number(user.id); %>
          <tr>
            <td><% if (canView) { %><a href="/tickets/<%= t.id %>" style="color:var(--primary);text-decoration:none;font-weight:600;"><%= t.ticket_number %></a><% } else { %><span style="font-weight:600;"><%= t.ticket_number %></span><% } %></td>
            <td><% if (canView) { %><a href="/tickets/<%= t.id %>" style="color:var(--text);text-decoration:none;"><%= t.title %></a><% } else { %><%= t.title %><% } %></td>
            <td class="text-sm"><%= t.requester_name %></td>
            <td class="text-sm"><%= titleCase(t.category) %></td>
            <td><span class="badge badge-<%= t.priority %>"><%= titleCase(t.priority) %></span></td>
            <td><span class="badge badge-<%= t.status %>"><%= titleCase(t.status) %></span></td>
            <td class="text-sm"><% if (t.assigned_name) { %><%= t.assigned_name %><% } else { %><span class="text-muted">Unassigned</span><% } %></td>
            <td class="text-sm"><%= formatDateTime(t.created_at) %></td>
            <td class="actions-cell">
              <% if (canView) { %><a href="/tickets/<%= t.id %>" class="btn btn-sm btn-outline" aria-label="View ticket"><i class="fas fa-eye" aria-hidden="true"></i></a><% } else { %><span class="text-muted" title="Assigned to another technician">—</span><% } %>
            </td>
          </tr>
          <% }) %>
      </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('../../partials/pagination') %>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
