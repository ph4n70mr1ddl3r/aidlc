<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div>
    <h2><%= isEdit ? 'Edit Ticket' : 'New Ticket' %></h2>
    <div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/tickets">Tickets</a> / <%= isEdit ? 'Edit' : 'New' %></div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <form action="<%= isEdit ? '/tickets/' + ticket.id + '?_method=PUT' : '/tickets' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="form-group" style="grid-column:1/-1;">
          <label>Title *</label>
          <input type="text" name="title" class="form-control" value="<%= ticket.title || '' %>" maxlength="200" required>
        </div>
        <div class="form-group" style="grid-column:1/-1;">
          <label>Description</label>
          <textarea name="description" class="form-control" rows="4" maxlength="5000"><%= ticket.description || '' %></textarea>
        </div>
        <div class="form-group">
          <label>Category *</label>
          <select name="category" class="form-control" required>
            <option value="">Select category</option>
            <% CONSTANTS.TICKET_CATEGORIES.forEach(c => { %>
              <option value="<%= c %>" <%= ticket.category === c ? 'selected' : '' %>><%= c.charAt(0).toUpperCase() + c.slice(1) %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Priority *</label>
          <select name="priority" class="form-control" required>
            <% CONSTANTS.TICKET_PRIORITIES.forEach(p => { %>
              <option value="<%= p %>" <%= (ticket.priority || 'medium') === p ? 'selected' : '' %>><%= p.charAt(0).toUpperCase() + p.slice(1) %></option>
            <% }) %>
          </select>
        </div>
        <% if (isEdit) { %>
        <div class="form-group">
          <label>Status</label>
          <select name="status" class="form-control">
            <% CONSTANTS.TICKET_STATUSES.forEach(s => { %>
              <option value="<%= s %>" <%= ticket.status === s ? 'selected' : '' %>><%= s.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %></option>
            <% }) %>
          </select>
        </div>
        <% } %>
        <div class="form-group">
          <label>Assigned To</label>
          <select name="assigned_to" class="form-control">
            <option value="">Unassigned</option>
            <% staff.forEach(s => { %>
              <option value="<%= s.id %>" <%= ticket.assigned_to == s.id ? 'selected' : '' %>><%= s.first_name %> <%= s.last_name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Related Asset</label>
          <select name="asset_id" class="form-control">
            <option value="">None</option>
            <% assets.forEach(a => { %>
              <option value="<%= a.id %>" <%= ticket.asset_id == a.id ? 'selected' : '' %>><%= a.asset_tag %> - <%= a.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Due Date</label>
          <input type="date" name="due_date" class="form-control" value="<%= ticket.due_date ? ticket.due_date.slice(0,10) : '' %>">
        </div>
      </div>
      
      <h4 style="margin-top:24px;margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border);">Requester Information</h4>
      <div class="form-grid">
        <div class="form-group">
          <label>Requester Name *</label>
          <input type="text" name="requester_name" class="form-control" value="<%= ticket.requester_name || '' %>" maxlength="100" required>
        </div>
        <div class="form-group">
          <label>Requester Email *</label>
          <input type="email" name="requester_email" class="form-control" value="<%= ticket.requester_email || '' %>" maxlength="200" required autocomplete="email">
        </div>
        <div class="form-group">
          <label>Department</label>
          <input type="text" name="requester_department" class="form-control" value="<%= ticket.requester_department || '' %>" maxlength="100">
        </div>
        <div class="form-group">
          <label>Phone</label>
          <input type="text" name="requester_phone" class="form-control" value="<%= ticket.requester_phone || '' %>" maxlength="50">
        </div>
      </div>

      <% if (isEdit) { %>
      <div class="form-group">
        <label>Resolution Notes</label>
        <textarea name="resolution_notes" class="form-control" rows="3" maxlength="5000"><%= ticket.resolution_notes || '' %></textarea>
      </div>
      <% } %>

      <div style="margin-top:20px;display:flex;gap:12px;">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= isEdit ? 'Update Ticket' : 'Create Ticket' %></button>
        <a href="/tickets" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
