<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header">
  <div><h2><%= vendor.name %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/vendors">Vendors</a> / <%= vendor.name %></div></div>
  <% if (isPrivileged(user)) { %>
  <div class="flex gap-2">
    <a href="/vendors/<%= vendor.id %>/edit" class="btn btn-secondary"><i class="fas fa-edit" aria-hidden="true"></i> Edit</a>
    <% // Delete only renders for inactive vendors — the route refuses to delete
       // an active vendor ("Deactivate the vendor before deleting"), so showing
       // the button on active vendors would always fail after confirmation.
       // Mirrors the staff show page's state-dependent action pattern. %>
    <% if (!vendor.is_active) { %>
    <form action="/vendors/<%= vendor.id %>?_method=DELETE" method="POST" style="display:inline;" data-confirm="Delete this vendor permanently? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-danger"><i class="fas fa-trash" aria-hidden="true"></i> Delete</button></form>
    <% } %>
  </div>
  <% } %>
</div>
<div class="card"><div class="card-body">
  <div class="detail-row"><div class="detail-label">Name</div><div class="detail-value" style="font-weight:600;"><%= vendor.name %></div></div>
  <div class="detail-row"><div class="detail-label">Contact Person</div><div class="detail-value"><%= vendor.contact_person || '-' %></div></div>
  <div class="detail-row"><div class="detail-label">Email</div><div class="detail-value"><% if (vendor.email && isValidEmail(vendor.email)) { %><a href="mailto:<%= vendor.email %>"><%= vendor.email %></a><% } else if (vendor.email) { %><%= vendor.email %><% } else { %>-<% } %></div></div>
  <div class="detail-row"><div class="detail-label">Phone</div><div class="detail-value"><%= vendor.phone || '-' %></div></div>
  <div class="detail-row"><div class="detail-label">Address</div><div class="detail-value"><%= vendor.address || '-' %></div></div>
  <div class="detail-row"><div class="detail-label">Website</div><div class="detail-value"><% if (vendor.website && /^https?:\/\//i.test(vendor.website)) { %><a href="<%= vendor.website %>" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"><%= vendor.website %></a><% } else if (vendor.website) { %><%= vendor.website %><% } else { %>-<% } %></div></div>
  <div class="detail-row"><div class="detail-label">Category</div><div class="detail-value"><%= vendor.category ? titleCase(vendor.category) : '-' %></div></div>
  <div class="detail-row"><div class="detail-label">Contract</div><div class="detail-value"><%= vendor.contract_start ? formatDate(vendor.contract_start) : '?' %> — <%= vendor.contract_end ? formatDate(vendor.contract_end) : '?' %></div></div>
  <div class="detail-row"><div class="detail-label">Rating</div><div class="detail-value" <% if (vendor.rating) { %>role="img" aria-label="<%= vendor.rating %> out of 5 stars"<% } %>><% if (vendor.rating) { for (let i=0;i<vendor.rating;i++) { %><i class="fas fa-star" style="color:var(--warning);" aria-hidden="true"></i><% } for (let i=vendor.rating;i<5;i++) { %><i class="far fa-star" style="color:var(--border);" aria-hidden="true"></i><% } } else { %>-<% } %></div></div>
  <div class="detail-row"><div class="detail-label">Active</div><div class="detail-value"><span class="badge badge-<%= vendor.is_active ? 'low' : 'critical' %>"><%= vendor.is_active ? 'Active' : 'Inactive' %></span></div></div>
  <% if (vendor.notes) { %><div class="detail-row"><div class="detail-label">Notes</div><div class="detail-value" style="white-space:pre-wrap;"><%= vendor.notes %></div></div><% } %>
</div></div>

<% if (isPrivileged(user)) { %>
<div class="card mt-2">
  <div class="card-header"><h3><i class="fas fa-cog" aria-hidden="true" style="margin-right:8px;color:var(--text-light)"></i>Actions</h3></div>
  <div class="card-body">
    <% if (vendor.is_active) { %>
    <form action="/vendors/<%= vendor.id %>/deactivate?_method=PUT" method="POST" data-confirm="Deactivate this vendor?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-sm btn-outline" style="color:var(--danger);border-color:var(--danger);"><i class="fas fa-ban" aria-hidden="true"></i> Deactivate Vendor</button>
    </form>
    <% } else { %>
    <form action="/vendors/<%= vendor.id %>/reactivate?_method=PUT" method="POST" data-confirm="Reactivate this vendor?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-sm btn-success"><i class="fas fa-check-circle" aria-hidden="true"></i> Reactivate Vendor</button>
    </form>
    <% } %>
  </div>
</div>
<% } %>
<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
