<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header"><div><h2>Vendors <span class="text-sm text-muted" style="font-weight:normal;">(<%= total %> total)</span></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / Vendors</div></div><% if (isPrivileged(user)) { %><a href="/vendors/new" class="btn btn-primary"><i class="fas fa-plus"></i> New Vendor</a><% } %></div>
<form method="GET" action="/vendors" class="filter-bar">
  <input type="text" name="search" class="search-input" autocomplete="off" placeholder="Search vendors..." aria-label="Search vendors" value="<%= filters.search || '' %>" maxlength="<%= CONSTANTS.MAX_SEARCH %>">
  <select name="category" aria-label="Filter by category">
    <option value="">All Categories</option>
    <% CONSTANTS.VENDOR_CATEGORIES.forEach(c => { %>
      <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= titleCase(c) %></option>
    <% }) %>
  </select>
  <select name="is_active" aria-label="Filter by status">
    <option value="">All Status</option>
    <option value="1" <%= filters.is_active === '1' ? 'selected' : '' %>>Active</option>
    <option value="0" <%= filters.is_active === '0' ? 'selected' : '' %>>Inactive</option>
  </select>
  <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i> Filter</button>
  <a href="/vendors" class="btn btn-sm btn-outline">Clear</a>
</form>
<div class="card"><div class="card-body" style="padding:0;">
  <% if (vendors.length === 0) { %><div class="empty-state"><i class="fas fa-building"></i><h3>No vendors found</h3><p>Add your first vendor or adjust filters</p></div>
  <% } else { %><div class="table-responsive"><table>
    <thead><tr><th>Name</th><th>Contact</th><th>Email</th><th>Category</th><th>Contract End</th><th>Rating</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody><% vendors.forEach(v => { %><tr>
      <td><% if (isPrivileged(user)) { %><a href="/vendors/<%= v.id %>" style="color:var(--text);font-weight:600;text-decoration:none;"><%= v.name %></a><% } else { %><span style="font-weight:600;"><%= v.name %></span><% } %></td>
      <td class="text-sm"><%= v.contact_person || '-' %></td>
      <td class="text-sm"><%= v.email || '-' %></td>
      <td class="text-sm"><%= v.category ? titleCase(v.category) : '-' %></td>
      <td class="text-sm"><%= v.contract_end ? formatDate(v.contract_end) : '-' %></td>
      <td><% if (v.rating) { for (let i=0;i<v.rating;i++) { %><i class="fas fa-star" style="color:var(--warning);font-size:12px;"></i><% } for (let i=v.rating;i<5;i++) { %><i class="far fa-star" style="color:var(--border);font-size:12px;"></i><% } } else { %>-<% } %></td>
      <td><span class="badge badge-<%= v.is_active ? 'low' : 'critical' %>"><%= v.is_active ? 'Active' : 'Inactive' %></span></td>
      <td class="actions-cell"><% if (isPrivileged(user)) { %><a href="/vendors/<%= v.id %>" class="btn btn-sm btn-outline" aria-label="View vendor"><i class="fas fa-eye" aria-hidden="true"></i></a><% } else { %><span class="text-muted" title="Admin/manager only">—</span><% } %></td>
    </tr><% }) %></tbody>
  </table></div><% } %>
</div></div>
<%- include('../../partials/pagination') %>
<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
