<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>
<div class="page-header"><div><h2><%= isEdit ? 'Edit Vendor' : 'New Vendor' %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/vendors">Vendors</a> / <%= isEdit ? 'Edit' : 'New' %></div></div></div>
<div class="card"><div class="card-body">
  <form action="<%= isEdit ? '/vendors/' + vendor.id + '?_method=PUT' : '/vendors' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="form-group"><label for="name">Vendor Name *</label><input type="text" name="name" id="name" class="form-control" value="<%= vendor.name || '' %>" maxlength="<%= CONSTANTS.MAX_MEDIUM_STR %>" required></div>
      <div class="form-group"><label for="contact_person">Contact Person</label><input type="text" name="contact_person" id="contact_person" class="form-control" value="<%= vendor.contact_person || '' %>" maxlength="<%= CONSTANTS.MAX_SHORT_STR %>"></div>
      <div class="form-group"><label for="email">Email</label><input type="email" name="email" id="email" class="form-control" value="<%= vendor.email || '' %>" maxlength="<%= CONSTANTS.MAX_EMAIL %>" autocomplete="email"></div>
      <div class="form-group"><label for="phone">Phone</label><input type="text" name="phone" id="phone" class="form-control" value="<%= vendor.phone || '' %>" maxlength="<%= CONSTANTS.MAX_PHONE %>"></div>
      <div class="form-group"><label for="address">Address</label><input type="text" name="address" id="address" class="form-control" value="<%= vendor.address || '' %>" maxlength="<%= CONSTANTS.MAX_ADDRESS %>"></div>
      <div class="form-group"><label for="website">Website</label><input type="url" name="website" id="website" class="form-control" value="<%= vendor.website || '' %>" maxlength="<%= CONSTANTS.MAX_LONG_STR %>"></div>
      <div class="form-group"><label for="category">Category</label><select name="category" id="category" class="form-control">
        <option value="">Select category</option>
        <% CONSTANTS.VENDOR_CATEGORIES.forEach(c => { %>
          <option value="<%= c %>" <%= vendor.category === c ? 'selected' : '' %>><%= titleCase(c) %></option>
        <% }) %>
      </select></div>
      <div class="form-group"><label for="contract_start">Contract Start</label><input type="date" name="contract_start" id="contract_start" class="form-control" value="<%= vendor.contract_start ? vendor.contract_start.slice(0,10) : '' %>"></div>
      <div class="form-group"><label for="contract_end">Contract End</label><input type="date" name="contract_end" id="contract_end" class="form-control" value="<%= vendor.contract_end ? vendor.contract_end.slice(0,10) : '' %>"></div>
      <div class="form-group"><label for="rating">Rating (1-5)</label><input type="number" name="rating" id="rating" class="form-control" min="1" max="5" step="1" value="<%= vendor.rating != null ? vendor.rating : '' %>"></div>
      <% if (isEdit) { %><div class="form-group"><label>Status</label><span class="badge badge-<%= vendor.is_active ? 'low' : 'critical' %>"><%= vendor.is_active ? 'Active' : 'Inactive' %></span></div><% } %>
    </div>
    <div class="form-group"><label for="notes">Notes</label><textarea name="notes" id="notes" class="form-control" maxlength="<%= CONSTANTS.MAX_NOTES %>"><%= vendor.notes || '' %></textarea></div>
    <div style="margin-top:20px;display:flex;gap:12px;">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= isEdit ? 'Update' : 'Create' %></button>
      <a href="/vendors" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div></div>
<%- include('../../partials/nav-close') %><%- include('../../partials/footer') %>
