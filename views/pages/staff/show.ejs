<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div><h2><%= staffUser.first_name %> <%= staffUser.last_name %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/staff">Staff</a> / <%= staffUser.first_name %> <%= staffUser.last_name %></div></div>
  <div class="flex gap-2">
    <a href="/staff/<%= staffUser.id %>/edit" class="btn btn-secondary"><i class="fas fa-edit"></i> Edit</a>
  </div>
</div>

<div class="grid-2-1">
  <div>
    <!-- Active Tickets -->
    <div class="card mb-3">
      <div class="card-header"><h3><i class="fas fa-ticket" style="margin-right:8px;color:var(--primary)"></i>Assigned Tickets (<%= assignedTickets.length %>)</h3></div>
      <div class="card-body" style="padding:0;">
        <% if (assignedTickets.length) { %>
        <div class="table-responsive"><table>
          <thead><tr><th>Ticket</th><th>Title</th><th>Priority</th><th>Status</th></tr></thead>
          <tbody><% assignedTickets.forEach(t => { %><tr>
            <td><a href="/tickets/<%= t.id %>" style="color:var(--primary);text-decoration:none;font-weight:600;"><%= t.ticket_number %></a></td>
            <td><%= t.title %></td>
            <td><span class="badge badge-<%= t.priority %>"><%= t.priority %></span></td>
            <td><span class="badge badge-<%= t.status %>"><%= t.status.replace(/_/g, ' ') %></span></td>
          </tr><% }) %></tbody>
        </table></div><% } else { %><p class="text-muted text-sm" style="padding:16px;">No active tickets</p><% } %>
      </div>
    </div>

    <!-- Active Tasks -->
    <div class="card mb-3">
      <div class="card-header"><h3><i class="fas fa-tasks" style="margin-right:8px;color:var(--primary)"></i>Active Tasks (<%= assignedTasks.length %>)</h3></div>
      <div class="card-body">
        <% assignedTasks.forEach(t => { %>
        <div style="padding:8px 0;border-bottom:1px solid var(--border);">
          <div class="text-sm" style="font-weight:600;"><%= t.title %></div>
          <div class="text-sm text-muted"><a href="/projects/<%= t.project_id %>" style="color:var(--primary);text-decoration:none;"><%= t.project_name %></a> · Due: <%= t.due_date ? new Date(t.due_date).toLocaleDateString() : 'Not set' %></div>
        </div>
        <% }) %>
        <% if (!assignedTasks.length) { %><p class="text-muted text-sm">No active tasks</p><% } %>
      </div>
    </div>
  </div>

  <div>
    <!-- Profile Info -->
    <div class="card mb-2">
      <div class="card-body" style="text-align:center;">
        <div class="user-avatar" style="width:64px;height:64px;font-size:24px;margin:0 auto 12px;"><%= staffUser.first_name[0] %><%= staffUser.last_name[0] %></div>
        <h3><%= staffUser.first_name %> <%= staffUser.last_name %></h3>
        <span class="badge badge-<%= staffUser.role === 'admin' ? 'critical' : staffUser.role === 'manager' ? 'high' : 'medium' %>" style="margin-top:8px;"><%= staffUser.role %></span>
        <div class="text-sm text-muted mt-2"><%= staffUser.department || '' %></div>
      </div>
    </div>
    <div class="card mb-2">
      <div class="card-body" style="padding:0;">
        <div class="detail-row"><div class="detail-label">Email</div><div class="detail-value"><a href="mailto:<%= staffUser.email %>"><%= staffUser.email %></a></div></div>
        <div class="detail-row"><div class="detail-label">Phone</div><div class="detail-value"><%= staffUser.phone || '-' %></div></div>
        <div class="detail-row"><div class="detail-label">Status</div><div class="detail-value"><span class="badge badge-<%= staffUser.is_active ? 'low' : 'critical' %>"><%= staffUser.is_active ? 'Active' : 'Inactive' %></span></div></div>
        <div class="detail-row"><div class="detail-label">Last Login</div><div class="detail-value"><%= staffUser.last_login ? new Date(staffUser.last_login).toLocaleString() : 'Never' %></div></div>
      </div>
    </div>

    <!-- Projects -->
    <div class="card mb-2">
      <div class="card-header"><h3>Projects</h3></div>
      <div class="card-body">
        <% projectMemberships.forEach(pm => { %>
        <div style="padding:4px 0;"><a href="/projects/<%= pm.project_id %>" style="text-decoration:none;color:var(--text);font-size:13px;"><%= pm.project_name %></a> <span class="badge badge-<%= pm.project_status %>"><%= pm.project_role %></span></div>
        <% }) %>
        <% if (!projectMemberships.length) { %><p class="text-muted text-sm">Not in any projects</p><% } %>
      </div>
    </div>

    <!-- Assigned Assets -->
    <div class="card">
      <div class="card-header"><h3>Assets</h3></div>
      <div class="card-body">
        <% assignedAssets.forEach(a => { %>
        <div style="padding:4px 0;"><a href="/assets/<%= a.id %>" style="text-decoration:none;color:var(--text);font-size:13px;"><%= a.asset_tag %> - <%= a.name %></a> <span class="badge badge-<%= a.status %>"><%= a.status.replace(/_/g, ' ') %></span></div>
        <% }) %>
        <% if (!assignedAssets.length) { %><p class="text-muted text-sm">No assets assigned</p><% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
