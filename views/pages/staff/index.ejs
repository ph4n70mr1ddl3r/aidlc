<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div><h2>Staff <span class="text-sm text-muted" style="font-weight:normal;">(<%= total %> total)</span></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / Staff</div></div>
  <% if (user.role === 'admin' || user.role === 'manager') { %>
  <a href="/staff/new" class="btn btn-primary"><i class="fas fa-plus"></i> Add Staff</a>
  <% } %>
</div>

<form method="GET" action="/staff" class="filter-bar">
  <input type="text" name="search" class="search-input" autocomplete="off" placeholder="Search staff..." aria-label="Search staff" value="<%= filters.search || '' %>">
  <select name="role" aria-label="Filter by role">
    <option value="">All Roles</option>
    <% CONSTANTS.USER_ROLES.forEach(r => { %>
    <option value="<%= r %>" <%= filters.role === r ? 'selected' : '' %>><%= r.charAt(0).toUpperCase() + r.slice(1) %></option>
    <% }) %>
  </select>
  <select name="department" aria-label="Filter by department">
    <option value="">All Departments</option>
    <% departments.forEach(d => { %><option value="<%= d %>" <%= filters.department === d ? 'selected' : '' %>><%= d %></option><% }) %>
  </select>
  <select name="status" aria-label="Filter by status">
    <option value="">All Status</option>
    <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
    <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
  </select>
  <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-search"></i> Filter</button>
  <a href="/staff" class="btn btn-sm btn-outline">Clear</a>
</form>

<div class="card">
  <div class="card-body" style="padding:0;">
    <div class="table-responsive">
      <table>
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Department</th><th>Open Tickets</th><th>Open Tasks</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          <% staff.forEach(s => { %>
          <tr>
            <td><a href="/staff/<%= s.id %>" style="color:var(--text);text-decoration:none;font-weight:600;">
              <div class="flex items-center gap-2">
                <div class="user-avatar" style="width:28px;height:28px;font-size:11px;"><%= (s.first_name || '?')[0] %><%= (s.last_name || '?')[0] %></div>
                <%= s.first_name %> <%= s.last_name %>
              </div>
            </a></td>
            <td class="text-sm"><%= s.email %></td>
            <td><span class="badge badge-<%= s.role === 'admin' ? 'critical' : s.role === 'manager' ? 'high' : 'medium' %>"><%= s.role %></span></td>
            <td class="text-sm"><%= s.department || '-' %></td>
            <td class="text-sm"><%= s.open_tickets %></td>
            <td class="text-sm"><%= s.open_tasks %></td>
            <td><span class="badge badge-<%= s.is_active ? 'low' : 'critical' %>"><%= s.is_active ? 'Active' : 'Inactive' %></span></td>
            <td class="actions-cell">
              <a href="/staff/<%= s.id %>" class="btn btn-sm btn-outline" aria-label="View staff member"><i class="fas fa-eye" aria-hidden="true"></i></a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../../partials/pagination') %>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
