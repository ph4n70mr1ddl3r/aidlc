<%- include('../../partials/header') %>
<%- include('../../partials/nav') %>

<div class="page-header">
  <div><h2><%= isEdit ? 'Edit Staff Member' : 'New Staff Member' %></h2><div class="breadcrumb"><a href="/dashboard">Dashboard</a> / <a href="/staff">Staff</a> / <%= isEdit ? 'Edit' : 'New' %></div></div>
</div>

<div class="card"><div class="card-body">
  <form action="<%= isEdit ? '/staff/' + staffMember.id + '?_method=PUT' : '/staff' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <% if (!isEdit) { %>
      <div class="form-group"><label for="username">Username *</label><input type="text" name="username" id="username" class="form-control" value="<%= staffMember.username || '' %>" maxlength="<%= CONSTANTS.MAX_USERNAME %>" required></div>
      <div class="form-group"><label for="password">Password *</label><input type="password" name="password" id="password" class="form-control" required minlength="12" maxlength="<%= CONSTANTS.MAX_PASSWORD %>" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{12,}" title="Minimum 12 characters with uppercase, lowercase, number, and special character" autocomplete="new-password"></div>
      <% } else { %>
      <div class="form-group"><label for="username">Username</label><input type="text" id="username" class="form-control" value="<%= staffMember.username %>" disabled style="background:var(--bg)"></div>
      <% } %>
      <div class="form-group"><label for="first_name">First Name *</label><input type="text" name="first_name" id="first_name" class="form-control" value="<%= staffMember.first_name || '' %>" maxlength="<%= CONSTANTS.MAX_SHORT_STR %>" required></div>
      <div class="form-group"><label for="last_name">Last Name *</label><input type="text" name="last_name" id="last_name" class="form-control" value="<%= staffMember.last_name || '' %>" maxlength="<%= CONSTANTS.MAX_SHORT_STR %>" required></div>
      <div class="form-group"><label for="email">Email *</label><input type="email" name="email" id="email" class="form-control" value="<%= staffMember.email || '' %>" maxlength="<%= CONSTANTS.MAX_EMAIL %>" required autocomplete="email"></div>
      <div class="form-group"><label for="role">Role *</label><select name="role" id="role" class="form-control" required>
        <% CONSTANTS.USER_ROLES.forEach(r => { %>
          <% if (r !== 'admin' || typeof viewerRole === 'undefined' || viewerRole === 'admin') { %>
          <option value="<%= r %>" <%= staffMember.role === r ? 'selected' : '' %>><%= titleCase(r) %></option>
          <% } %>
        <% }) %>
      </select></div>
      <div class="form-group"><label for="department">Department</label><input type="text" name="department" id="department" class="form-control" value="<%= staffMember.department || '' %>" maxlength="<%= CONSTANTS.MAX_SHORT_STR %>"></div>
      <div class="form-group"><label for="phone">Phone</label><input type="text" name="phone" id="phone" class="form-control" value="<%= staffMember.phone || '' %>" maxlength="<%= CONSTANTS.MAX_PHONE %>"></div>
    </div>
    <div style="margin-top:20px;display:flex;gap:12px;">
      <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> <%= isEdit ? 'Update' : 'Create' %></button>
      <a href="/staff" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div></div>

<%- include('../../partials/nav-close') %>
<%- include('../../partials/footer') %>
